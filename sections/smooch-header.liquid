{{ 'section-smooch-header.css' | asset_url | stylesheet_tag }}

{%- if settings.cart_type == 'notification' -%}
  {{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign brand_name = settings.smooch_brand_name | default: shop.name
  assign menu = section.settings.menu
  assign cta_label = section.settings.cta_label | replace: '[brand]', brand_name
-%}

<header class="smooch-header color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="smooch-header__inner">
      {%- comment -%}
        Logo is a plain link, never an h1 — the page hero owns the h1.
      {%- endcomment -%}
      <a href="{{ routes.root_url }}" class="smooch-header__logo focus-inset">
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = settings.logo.alt | default: brand_name | escape -%}
          {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
          {%- capture sizes -%}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{%- endcapture -%}
          {%- capture widths -%}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{%- endcapture -%}
          {{
            settings.logo
            | image_url: width: 600
            | image_tag:
              class: 'smooch-header__logo-image',
              widths: widths,
              height: logo_height,
              width: settings.logo_width,
              alt: logo_alt,
              sizes: sizes,
              preload: true
          }}
        {%- else -%}
          {%- comment -%}
            Bundled brand wordmark (white artwork, ink-tinted via CSS for light
            headers). A merchant-uploaded logo in Theme settings overrides it.
          {%- endcomment -%}
          <img
            src="{{ 'smooch-logo-white.webp' | asset_url }}"
            width="712"
            height="183"
            class="smooch-header__logo-image smooch-header__logo-image--brand"
            alt="{{ brand_name | escape }}"
            style="width: {{ settings.logo_width | default: 110 }}px; height: auto;"
          >
        {%- endif -%}
      </a>

      {%- if menu != blank -%}
        <nav class="smooch-header__nav" aria-label="{{ menu.title | escape }}">
          <ul class="smooch-header__menu" role="list">
            {%- for link in menu.links -%}
              <li>
                <a
                  href="{{ link.url }}"
                  class="smooch-header__link focus-inset{% if link.current %} smooch-header__link--current{% endif %}"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{ link.title | escape }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <div class="smooch-header__actions">
        {%- if cta_label != blank and section.settings.cta_link != blank -%}
          <a href="{{ section.settings.cta_link }}" class="smooch-btn smooch-btn--brand smooch-header__cta">
            {{- cta_label | escape -}}
          </a>
        {%- endif -%}

        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <a
            href="{{ routes.account_url }}"
            class="header__icon header__icon--account link focus-inset smooch-header__account"
            rel="nofollow"
          >
            <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
            <span class="visually-hidden">
              {%- liquid
                if customer
                  echo 'customer.account_fallback' | t
                else
                  echo 'customer.log_in' | t
                endif
              -%}
            </span>
          </a>
        {%- endif -%}

        {%- comment -%}
          Cart contract: Dawn's cart JS replaces this anchor's innerHTML by id
          and binds the drawer to #cart-icon-bubble. Do not rename anything.
          Inner markup mirrors sections/cart-icon-bubble.liquid exactly.
        {%- endcomment -%}
        <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset smooch-header__cart" id="cart-icon-bubble">
          {% if cart == empty %}
            <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
          {% else %}
            <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
          {% endif %}
          <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
          {%- if cart != empty -%}
            <div class="cart-count-bubble">
              {%- if cart.item_count < 100 -%}
                <span aria-hidden="true">{{ cart.item_count }}</span>
              {%- endif -%}
              <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            </div>
          {%- endif -%}
        </a>

        {%- if menu != blank -%}
          <details id="Details-SmoochHeaderMenu-{{ section.id }}" class="smooch-header__disclosure">
            <summary
              class="smooch-header__toggle"
              aria-label="{{ 'sections.header.menu' | t }}"
              aria-controls="SmoochHeaderPanel-{{ section.id }}"
            >
              <span class="smooch-header__toggle-label">{{ 'sections.header.menu' | t }}</span>
              {% render 'smooch-icon', icon: 'caret', class: 'smooch-icon--sm smooch-header__caret' %}
            </summary>
            <div class="smooch-header__panel" id="SmoochHeaderPanel-{{ section.id }}">
              <nav class="page-width" aria-label="{{ menu.title | escape }}">
                <ul class="smooch-header__panel-menu" role="list">
                  {%- for link in menu.links -%}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="smooch-header__panel-link focus-inset{% if link.current %} smooch-header__panel-link--current{% endif %}"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ link.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </nav>
            </div>
          </details>
        {%- endif -%}
      </div>
    </div>
  </div>
</header>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme -%}
{%- endif -%}

{% schema %}
{
  "name": "Smooch header",
  "tag": "section",
  "class": "section smooch-header-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Minimal sticky conversion header. The logo image and its width come from Theme settings > Logo; when no logo is set, your brand name renders as a serif wordmark."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.settings.menu.label",
      "default": "main-menu",
      "info": "Top-level links only. Shown inline on desktop and inside the Menu dropdown on mobile."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop now",
      "info": "Shown on desktop only. Use [brand] to insert your brand name. Leave blank to hide."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": false,
      "info": "Only renders when customer accounts are enabled for the store."
    }
  ],
  "presets": [
    {
      "name": "Smooch header",
      "settings": {
        "color_scheme": "scheme-1",
        "menu": "main-menu",
        "cta_label": "Shop now",
        "cta_link": "/collections/all",
        "show_account": false
      }
    }
  ]
}
{% endschema %}
