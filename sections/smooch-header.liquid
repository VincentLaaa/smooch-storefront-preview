{{ 'section-smooch-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'smooch-header.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Minimal, centered-logo conversion header. Left: Shop/Learn mega-menu
  triggers. Center: logo, mathematically centered via a 3-column grid
  (equal 1fr outer tracks), not flex remaining-space centering. Right:
  account + cart + mobile menu toggle.

  Brand tokens (--brand-background/text/accent/secondary/border/fonts) are
  defined once in assets/section-smooch-header.css, aliased to the theme's
  existing global color tokens (Theme settings > Colors, smooch_color_*)
  and the section's own color scheme picker — recolor there, no CSS edits
  needed. See that file's "Brand tokens" comment for the full mapping.
{%- endcomment -%}

{%- liquid
  assign brand_name = settings.smooch_brand_name | default: shop.name

  assign shop_menu = section.settings.shop_menu
  assign learn_menu = section.settings.learn_menu

  assign featured_product = section.settings.featured_product
  if featured_product == blank
    assign featured_product = collections.all.products.first
  endif

  assign desktop_logo_width = section.settings.desktop_logo_width | default: 120
  assign mobile_logo_width = section.settings.mobile_logo_width | default: 92

  assign is_product_template = false
  if request.page_type == 'product'
    assign is_product_template = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --smooch-header-logo-w: {{ mobile_logo_width }}px;
    position: {% if section.settings.sticky_enabled %}sticky{% else %}static{% endif %};
    top: 0;
    z-index: 3;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --smooch-header-logo-w: {{ desktop_logo_width }}px;
    }
  }
{%- endstyle -%}

<header
  class="smooch-header color-{{ section.settings.color_scheme }}{% if section.settings.sticky_enabled %} smooch-header--sticky{% endif %}{% if section.settings.transparent_header %} smooch-header--transparent{% endif %}{% unless section.settings.show_cart_count %} smooch-header--hide-count{% endunless %}"
  data-smooch-header
  {% if section.settings.sticky_enabled %}data-header-sticky{% endif %}
  {% if is_product_template %}data-header-no-autohide{% endif %}
>
  <div class="smooch-header__inner page-width">
    <nav class="smooch-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="smooch-header__nav-list" role="list">
        {%- if shop_menu != blank and shop_menu.links.size > 0 -%}
          <li class="smooch-header__nav-item">
            <smooch-header-menu>
              <button
                type="button"
                class="smooch-header__trigger smooch-focus"
                id="SmoochShopTrigger-{{ section.id }}"
                aria-expanded="false"
                aria-controls="SmoochShopPanel-{{ section.id }}"
              >
                {{ shop_menu.title | default: 'Shop' | escape }}
              </button>
              <div
                class="smooch-header__panel"
                id="SmoochShopPanel-{{ section.id }}"
                role="region"
                aria-labelledby="SmoochShopTrigger-{{ section.id }}"
                hidden
              >
                <div class="smooch-header__panel-inner{% if featured_product == blank %} smooch-header__panel-inner--links-only{% endif %}">
                  <ul class="smooch-header__panel-links" role="list">
                    {%- for link in shop_menu.links -%}
                      <li>
                        <a href="{{ link.url }}" class="smooch-header__panel-link smooch-focus">{{ link.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>

                  {%- if featured_product != blank -%}
                    <a href="{{ featured_product.url }}" class="smooch-header__panel-card smooch-focus">
                      <span class="smooch-header__panel-card-media">
                        {%- if featured_product.featured_image != blank -%}
                          {{
                            featured_product.featured_image
                            | image_url: width: 320
                            | image_tag:
                              loading: 'lazy',
                              widths: '160, 240, 320',
                              sizes: '12rem',
                              alt: featured_product.featured_image.alt | default: featured_product.title
                          }}
                        {%- endif -%}
                      </span>
                      <span class="smooch-header__panel-card-body">
                        <span class="smooch-header__panel-card-title">{{ featured_product.title }}</span>
                        <span class="smooch-header__panel-card-cta">
                          Shop now
                          {% render 'smooch-icon', icon: 'arrow-right', class: 'smooch-icon--sm' %}
                        </span>
                      </span>
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </smooch-header-menu>
          </li>
        {%- endif -%}

        {%- if learn_menu != blank and learn_menu.links.size > 0 -%}
          <li class="smooch-header__nav-item">
            <smooch-header-menu>
              <button
                type="button"
                class="smooch-header__trigger smooch-focus"
                id="SmoochLearnTrigger-{{ section.id }}"
                aria-expanded="false"
                aria-controls="SmoochLearnPanel-{{ section.id }}"
              >
                {{ learn_menu.title | default: 'Learn' | escape }}
              </button>
              <div
                class="smooch-header__panel smooch-header__panel--simple"
                id="SmoochLearnPanel-{{ section.id }}"
                role="region"
                aria-labelledby="SmoochLearnTrigger-{{ section.id }}"
                hidden
              >
                <div class="smooch-header__panel-inner smooch-header__panel-inner--links-only">
                  <ul class="smooch-header__panel-links" role="list">
                    {%- for link in learn_menu.links -%}
                      <li>
                        <a href="{{ link.url }}" class="smooch-header__panel-link smooch-focus">{{ link.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            </smooch-header-menu>
          </li>
        {%- endif -%}
      </ul>
    </nav>

    <a href="{{ routes.root_url }}" class="smooch-header__logo smooch-focus" aria-label="{{ brand_name | escape }} — home">
      {%- if settings.logo != blank -%}
        {%- assign logo_alt = settings.logo.alt | default: brand_name | escape -%}
        {{
          settings.logo
          | image_url: width: 400
          | image_tag:
            class: 'smooch-header__logo-image',
            widths: '120, 200, 300, 400',
            alt: logo_alt,
            sizes: '(min-width: 750px) 160px, 92px',
            preload: true
        }}
      {%- else -%}
        {%- comment -%}
          Bundled brand wordmark (pink artwork, shown as-is on light headers,
          re-tinted white via CSS on dark schemes — see
          .smooch-header__logo-image--brand). A merchant-uploaded logo in
          Theme settings > Logo overrides it.
        {%- endcomment -%}
        <img
          src="{{ 'smooch-logo-pink.webp' | asset_url }}"
          width="712"
          height="183"
          class="smooch-header__logo-image smooch-header__logo-image--brand"
          alt="{{ brand_name | escape }}"
        >
      {%- endif -%}
    </a>

    <div class="smooch-header__actions">
      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a
          href="{{ routes.account_url }}"
          class="smooch-header__icon-btn smooch-header__account smooch-focus"
          rel="nofollow"
        >
          {% render 'smooch-icon', icon: 'user' %}
          <span class="visually-hidden">
            {%- if customer -%}
              {{- 'customer.account_fallback' | t -}}
            {%- else -%}
              {{- 'customer.log_in' | t -}}
            {%- endif -%}
          </span>
        </a>
      {%- endif -%}

      {%- comment -%}
        Cart contract: Dawn's cart JS replaces this anchor's innerHTML by id
        (#cart-icon-bubble) and rebinds the drawer to it. Inner markup mirrors
        snippets/smooch-cart-icon.liquid exactly (rendered by both here and
        sections/cart-icon-bubble.liquid) — do not rename/restructure either
        independently.
      {%- endcomment -%}
      <a href="{{ routes.cart_url }}" id="cart-icon-bubble" class="smooch-header__icon-btn smooch-header__cart smooch-focus">
        {% render 'smooch-cart-icon' %}
      </a>
    </div>

    {%- comment -%} Left column on mobile (nav occupies it on desktop instead — see CSS). {%- endcomment -%}
    <button
      type="button"
      class="smooch-header__hamburger smooch-focus"
      id="SmoochMobileToggle-{{ section.id }}"
      aria-expanded="false"
      aria-controls="SmoochMobileNav-{{ section.id }}"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      {% render 'smooch-icon', icon: 'menu' %}
    </button>
  </div>
</header>

<smooch-mobile-nav id="SmoochMobileNav-{{ section.id }}" data-toggle-id="SmoochMobileToggle-{{ section.id }}" hidden>
  <div class="smooch-mobile-nav__overlay" tabindex="-1"></div>
  <div class="smooch-mobile-nav__panel" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}">
    <div class="smooch-mobile-nav__head">
      <span class="smooch-mobile-nav__brand">{{ brand_name }}</span>
      <button type="button" class="smooch-mobile-nav__close smooch-focus" aria-label="{{ 'accessibility.close' | t }}">
        {% render 'smooch-icon', icon: 'close' %}
      </button>
    </div>

    <div class="smooch-mobile-nav__body">
      <ul class="smooch-mobile-nav__list" role="list">
        {%- if shop_menu != blank and shop_menu.links.size > 0 -%}
          <li>
            <details class="smooch-mobile-nav__group">
              <summary class="smooch-mobile-nav__group-label">
                <span>{{ shop_menu.title | default: 'Shop' | escape }}</span>
                {% render 'smooch-icon', icon: 'caret', class: 'smooch-icon--sm smooch-mobile-nav__caret' %}
              </summary>
              <ul class="smooch-mobile-nav__sublist" role="list">
                {%- for link in shop_menu.links -%}
                  <li><a href="{{ link.url }}" class="smooch-mobile-nav__sublink smooch-focus">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </details>
          </li>
        {%- endif -%}

        {%- if learn_menu != blank and learn_menu.links.size > 0 -%}
          <li>
            <details class="smooch-mobile-nav__group">
              <summary class="smooch-mobile-nav__group-label">
                <span>{{ learn_menu.title | default: 'Learn' | escape }}</span>
                {% render 'smooch-icon', icon: 'caret', class: 'smooch-icon--sm smooch-mobile-nav__caret' %}
              </summary>
              <ul class="smooch-mobile-nav__sublist" role="list">
                {%- for link in learn_menu.links -%}
                  <li><a href="{{ link.url }}" class="smooch-mobile-nav__sublink smooch-focus">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </details>
          </li>
        {%- endif -%}
      </ul>

      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="smooch-mobile-nav__account smooch-focus" rel="nofollow">
          {% render 'smooch-icon', icon: 'user', class: 'smooch-icon--sm' %}
          <span>
            {%- if customer -%}
              {{- 'customer.account_fallback' | t -}}
            {%- else -%}
              {{- 'customer.log_in' | t -}}
            {%- endif -%}
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>
</smooch-mobile-nav>

{% schema %}
{
  "name": "Smooch header",
  "tag": "section",
  "class": "section smooch-header-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Colors follow the theme's global brand tokens (Theme settings > Colors) plus the scheme below. Logo image and default width come from Theme settings > Logo; this section can override the on-screen size."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu",
      "info": "Top-level links only. Opens as a dropdown from \"Shop\"."
    },
    {
      "type": "link_list",
      "id": "learn_menu",
      "label": "Learn menu",
      "info": "Top-level links only. Opens as a dropdown from \"Learn\"."
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Shop menu featured product",
      "info": "Shown as a card inside the Shop dropdown. Defaults to your first product; leave the menu short if you'd rather not show one."
    },
    {
      "type": "header",
      "content": "Logo size"
    },
    {
      "type": "range",
      "id": "desktop_logo_width",
      "label": "Desktop logo width",
      "min": 80,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "Mobile logo width",
      "min": 60,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 92
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "sticky_enabled",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "transparent_header",
      "label": "Transparent until scrolled",
      "default": false,
      "info": "Only enable on pages with a full-bleed hero image directly beneath the header."
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true,
      "info": "Only renders when customer accounts are enabled for the store."
    },
    {
      "type": "checkbox",
      "id": "show_cart_count",
      "label": "Show cart item count",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Smooch header",
      "settings": {
        "color_scheme": "scheme-1"
      }
    }
  ]
}
{% endschema %}
