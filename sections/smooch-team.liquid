{{ 'section-smooch-team.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign brand_name = settings.smooch_brand_name | default: shop.name
  assign member_blocks = section.blocks | where: 'type', 'member'
-%}

<div class="smooch-band smooch-team color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <header class="smooch-team__head smooch-center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="smooch-eyebrow smooch-eyebrow--accent">
          {{- section.settings.eyebrow | replace: '[brand]', brand_name | escape -}}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="smooch-h2 smooch-team__heading">
          {{- section.settings.heading | replace: '[brand]', brand_name | escape -}}
        </h2>
      {%- endif -%}
      {%- if section.settings.lead != blank -%}
        <p class="smooch-lead smooch-team__lead">
          {{- section.settings.lead | replace: '[brand]', brand_name | escape -}}
        </p>
      {%- endif -%}
    </header>

    {%- if member_blocks.size > 0 -%}
      <ul class="smooch-team__grid" role="list">
        {%- for block in member_blocks -%}
          <li class="smooch-team__card" {{ block.shopify_attributes }}>
            <div class="smooch-team__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    sizes: '(min-width: 990px) 24vw, (min-width: 750px) 44vw, 90vw',
                    class: 'smooch-team__img',
                    alt: block.settings.image.alt | default: block.settings.name
                }}
              {%- else -%}
                {%- comment -%}
                  Bundled sample portrait used until the merchant uploads a
                  real team photo — same fallback pattern as the other
                  bundled visuals.
                {%- endcomment -%}
                <img
                  src="{{ 'smooch-team-' | append: forloop.index | append: '.jpg' | asset_url }}"
                  width="800"
                  height="1000"
                  loading="lazy"
                  class="smooch-team__img"
                  alt="{{ block.settings.name | escape }}"
                >
              {%- endif -%}
            </div>
            {%- if block.settings.name != blank -%}
              <h3 class="smooch-team__name">{{ block.settings.name | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.role != blank -%}
              <p class="smooch-team__role">{{ block.settings.role | replace: '[brand]', brand_name | escape }}</p>
            {%- endif -%}
            {%- if block.settings.bio != blank -%}
              <p class="smooch-team__bio">{{ block.settings.bio | replace: '[brand]', brand_name | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="smooch-caption smooch-center">Add team members to build the grid.</p>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="smooch-fine-print smooch-team__note smooch-center">
        {{- section.settings.note | escape -}}
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Smooch team",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "paragraph",
      "content": "Meet-the-team grid: portrait, name, role, and a one-line bio per person. The bundled sample portraits are placeholders — swap in real photos and keep the sample note honest until you do."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Meet our team"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The people behind the ritual."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead text",
      "default": "We're a small team who built the thing we couldn't find — and we take it ourselves.",
      "info": "Use [brand] to insert your brand name."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Fine-print note",
      "default": "Sample team shown for layout — real introductions coming soon.",
      "info": "Keep this honest while the portraits are placeholders. Clear it once real team photos are in."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Portrait",
          "info": "4:5 portrait works best. Leave blank for a bundled sample portrait."
        },
        { "type": "text", "id": "name", "label": "Name", "default": "Team member" },
        { "type": "text", "id": "role", "label": "Role", "default": "Role at [brand]" },
        {
          "type": "textarea",
          "id": "bio",
          "label": "One-line bio",
          "default": "A line about what they do and why it matters."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smooch team",
      "blocks": [
        {
          "type": "member",
          "settings": {
            "name": "Claire Bennett",
            "role": "Founder & CEO",
            "bio": "Started [brand] when her own spark went quiet — and built the thing she couldn't find."
          }
        },
        {
          "type": "member",
          "settings": {
            "name": "Emma Hartley",
            "role": "Head of Formulation",
            "bio": "Four ingredients, each earning its place. She reads the research so you don't have to."
          }
        },
        {
          "type": "member",
          "settings": {
            "name": "Molly Pierce",
            "role": "Community & Care",
            "bio": "Reads every message that comes in — and answers most of them herself."
          }
        },
        {
          "type": "member",
          "settings": {
            "name": "Kate Sullivan",
            "role": "Brand & Operations",
            "bio": "Keeps the ritual simple, the shipping fast, and the guarantee honest."
          }
        }
      ]
    }
  ]
}
{% endschema %}
