{{ 'section-smooch-support-areas.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.7 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign brand_name = settings.smooch_brand_name | default: shop.name
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'

  assign width_class = 'page-width'
  if section.settings.section_width == 'narrow'
    assign width_class = 'page-width page-width--narrow'
  endif

  assign image_alt = section.settings.image_alt
  if image_alt == blank
    assign image_alt = section.settings.image.alt
  endif
  if image_alt == blank
    assign image_alt = brand_name | append: ' product'
  endif
-%}

<div class="smooch-band smooch-support color-{{ section.settings.color_scheme }} gradient">
  <div class="{{ width_class }} section-{{ section.id }}-padding">
    <div class="smooch-support__inner">
      <div class="smooch-support__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="smooch-eyebrow smooch-eyebrow--accent">
            {{- section.settings.eyebrow | replace: '[brand]', brand_name | escape -}}
          </p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="smooch-h2">
            {{- section.settings.heading | replace: '[brand]', brand_name | escape -}}
          </h2>
        {%- endif -%}
        {%- if section.settings.lead != blank -%}
          <p class="smooch-lead smooch-support__lead">
            {{- section.settings.lead | replace: '[brand]', brand_name | escape -}}
          </p>
        {%- endif -%}
      </div>

      <div class="smooch-support__visual">
        <div class="smooch-support__frame">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '360, 540, 720, 900',
                sizes: '(min-width: 990px) 40vw, 90vw',
                class: 'smooch-support__visual-img',
                alt: image_alt
            }}
          {%- else -%}
            {%- comment -%}
              Bundled real product photo used until a merchant picks one.
            {%- endcomment -%}
            <img
              src="{{ 'smooch-demo-bottle-open.png' | asset_url }}"
              width="1086"
              height="1448"
              loading="lazy"
              class="smooch-support__visual-img"
              alt="{{ image_alt | escape }}"
            >
          {%- endif -%}
        </div>
      </div>

      {%- if benefit_blocks.size > 0 -%}
        <ul class="smooch-support__list" role="list">
          {%- for block in benefit_blocks -%}
            <li class="smooch-support__item" {{ block.shopify_attributes }}>
              <span class="smooch-support__icon">
                {%- render 'smooch-icon', icon: block.settings.icon, class: 'smooch-icon--lg' -%}
              </span>
              <span class="smooch-support__item-body">
                {%- if block.settings.title != blank -%}
                  <span class="smooch-support__item-title">
                    {{- block.settings.title | replace: '[brand]', brand_name | escape -}}
                  </span>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="smooch-support__item-text">
                    {{- block.settings.text | replace: '[brand]', brand_name | escape -}}
                  </span>
                {%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="smooch-fine-print smooch-support__disclaimer">
        {{- section.settings.disclaimer | escape -}}
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Smooch support areas",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "PDP-only editorial section: a split layout (image + copy) that deepens conviction after the buybox — one short line per benefit, no long paragraphs."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "narrow", "label": "Narrow" }
      ],
      "default": "standard"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What [brand] supports",
      "info": "Use [brand] to insert the brand name."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "More than one part of you."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Supporting copy",
      "default": "[brand] is designed to support the emotional and physical parts of intimacy that can feel easier to lose — and harder to talk about.*",
      "info": "Use [brand] to insert the brand name."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Leave blank to use the image's own alt text."
    },
    {
      "type": "header",
      "content": "Disclaimer"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "glow", "label": "Glow (mood)" },
            { "value": "ember", "label": "Ember (desire)" },
            { "value": "ripple", "label": "Ripple (pleasure)" },
            { "value": "entwine", "label": "Entwine (connection)" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "heart", "label": "Heart" },
            { "value": "moon", "label": "Moon" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "drop", "label": "Drop" }
          ],
          "default": "glow"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feel more at ease."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Support a calmer, lighter, more open version of you.*",
          "info": "One short sentence — this is meant to be scanned, not read."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smooch support areas",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "glow",
            "title": "Feel more at ease.",
            "text": "Support a calmer, lighter, more open version of you.*"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "ember",
            "title": "Reconnect with your spark.",
            "text": "Support healthy desire and a more natural sense of wanting.*"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "ripple",
            "title": "Support the feel-good side of intimacy.",
            "text": "Support arousal, sensitivity, and satisfaction.*"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "entwine",
            "title": "Feel more present together.",
            "text": "When you feel better in yourself, connection can come more naturally.*"
          }
        }
      ]
    }
  ]
}
{% endschema %}
