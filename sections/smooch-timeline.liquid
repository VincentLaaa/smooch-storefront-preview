{{ 'section-smooch-timeline.css' | asset_url | stylesheet_tag }}
{{ 'smooch-scroll-story.css' | asset_url | stylesheet_tag }}
<script src="{{ 'smooch-scroll-story.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Sticky floating product visual beside the timeline steps, reusing the same
  scene markup/CSS classes and JS (assets/smooch-scroll-story.*) as the
  product-page scroll story — no separate animation system to maintain.
  Each step doubles as that JS's "stage" (data-smooch-stage), so gummies
  reveal progressively as the visitor reads through the timeline, without
  changing the steps' own look.

  No fake product art: if no image is picked in section settings, this falls
  back to the theme's bundled real product photo (same pattern as the header
  logo's bundled-wordmark fallback) rather than drawing a placeholder shape.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign brand_name = settings.smooch_brand_name | default: shop.name
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign fact_blocks = section.blocks | where: 'type', 'fact'
  assign show_visual = section.settings.show_visual
-%}

<div class="smooch-band color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div
      class="smooch-timeline__layout{% unless show_visual %} smooch-timeline__layout--no-visual{% endunless %}{% if show_visual %} smooch-story{% endif %}"
      {% if show_visual %}
        data-smooch-story
        data-mode="full"
        data-stage-count="{{ step_blocks.size }}"
        {% if section.settings.enable_floating %}data-floating-enabled{% endif %}
      {% endif %}
    >
      {%- if section.settings.eyebrow != blank
        or section.settings.heading != blank
        or section.settings.lead != blank
      -%}
        <header class="smooch-section-head smooch-timeline__head">
          {%- if section.settings.eyebrow != blank -%}
            <p class="smooch-eyebrow smooch-eyebrow--accent">
              {{- section.settings.eyebrow | replace: '[brand]', brand_name | escape -}}
            </p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="smooch-h2">
              {{- section.settings.heading | replace: '[brand]', brand_name | escape -}}
            </h2>
          {%- endif -%}
          {%- if section.settings.lead != blank -%}
            <p class="smooch-lead">
              {{- section.settings.lead | replace: '[brand]', brand_name | escape -}}
            </p>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- if show_visual -%}
        <div class="smooch-timeline__visual-col">
          <div class="smooch-timeline__visual-sticky">
            <div class="smooch-story__scene smooch-timeline__scene" data-smooch-scene aria-hidden="true">
              <span class="smooch-story__halo" data-smooch-halo></span>

              {%- for i in (1..3) -%}
                {%- assign img_key = 'gummy_image_' | append: i -%}
                {%- assign gummy_img = section.settings[img_key] -%}
                {%- if gummy_img != blank -%}
                  <span class="smooch-story__gummy smooch-story__gummy--{{ i }}" data-smooch-gummy data-gummy-index="{{ i }}">
                    {{
                      gummy_img
                      | image_url: width: 240
                      | image_tag: loading: 'lazy', widths: '80, 120, 180, 240', sizes: '10vw', alt: '', class: 'smooch-story__gummy-img'
                    }}
                  </span>
                {%- endif -%}
              {%- endfor -%}

              <span class="smooch-story__shadow" data-smooch-shadow></span>

              <div class="smooch-story__product-scroll" data-smooch-product-scroll>
                {%- assign product_alt = section.settings.product_alt | default: brand_name -%}
                <span class="smooch-story__product" data-smooch-product data-floating>
                  {%- if section.settings.product_image != blank -%}
                    {{
                      section.settings.product_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '300, 450, 600, 750, 900',
                        sizes: '(min-width: 990px) 26vw, 60vw',
                        alt: product_alt,
                        class: 'smooch-story__product-img'
                    }}
                  {%- else -%}
                    {%- comment -%}
                      Bundled real product photo used until a merchant picks
                      one — see the paragraph note in this section's schema.
                    {%- endcomment -%}
                    {{
                      'smooch-demo-bottle-open.png'
                      | asset_url
                      | image_tag:
                        loading: 'lazy',
                        width: 1086,
                        height: 1448,
                        alt: product_alt,
                        class: 'smooch-story__product-img'
                    }}
                  {%- endif -%}
                </span>
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}

      <div class="smooch-timeline__content-col">
        {%- if step_blocks.size > 0 -%}
          <ol class="smooch-timeline__steps" role="list">
            {%- for block in step_blocks -%}
              <li
                class="smooch-timeline__step"
                {% if show_visual %}
                  data-smooch-stage
                  data-stage-index="{{ forloop.index0 }}"
                {% endif %}
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.period != blank -%}
                  <p class="smooch-timeline__period smooch-num">
                    {{- block.settings.period | escape -}}
                  </p>
                {%- endif -%}

                <div class="smooch-timeline__marker" aria-hidden="true">
                  {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
                    <span class="smooch-timeline__badge">
                      {%- render 'smooch-icon', icon: block.settings.icon -%}
                    </span>
                  {%- else -%}
                    <span class="smooch-timeline__badge smooch-timeline__badge--dot"></span>
                  {%- endif -%}
                </div>

                <div class="smooch-timeline__body">
                  {%- if block.settings.heading != blank -%}
                    <h3 class="smooch-h3 smooch-timeline__heading">
                      {{- block.settings.heading | replace: '[brand]', brand_name | escape -}}
                    </h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="smooch-body smooch-timeline__text">
                      {{- block.settings.text | replace: '[brand]', brand_name | escape -}}
                    </p>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        {%- if fact_blocks.size > 0 -%}
          <div class="smooch-timeline__facts">
            {%- for fact in fact_blocks -%}
              {%- if fact.settings.title != blank -%}
                <div class="smooch-timeline__fact" {{ fact.shopify_attributes }}>
                  <h3 class="smooch-timeline__fact-title">{{ fact.settings.title | replace: '[brand]', brand_name | escape }}</h3>
                  <p class="smooch-timeline__fact-text">{{ fact.settings.text | replace: '[brand]', brand_name | escape }}</p>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.disclaimer != blank -%}
          <p class="smooch-fine-print smooch-timeline__disclaimer">
            {{- section.settings.disclaimer | replace: '[brand]', brand_name | escape -}}
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Smooch timeline",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "A cautious \"what to expect\" timeline. Keep every step supportive and non-promissory — never promise a specific outcome at a specific time."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The honest timeline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Support that builds, gently."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead paragraph",
      "default": "This is a daily-support formula, not a switch. Here's the shape most consistent routines take — experiences vary."
    },
    {
      "type": "header",
      "content": "Floating product visual"
    },
    {
      "type": "checkbox",
      "id": "show_visual",
      "label": "Show floating product visual",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image",
      "info": "A transparent PNG/WebP works best. Falls back to a bundled product photo until you set one."
    },
    {
      "type": "text",
      "id": "product_alt",
      "label": "Product image alt text",
      "info": "Defaults to your brand name if left blank."
    },
    {
      "type": "image_picker",
      "id": "gummy_image_1",
      "label": "Gummy image 1"
    },
    {
      "type": "image_picker",
      "id": "gummy_image_2",
      "label": "Gummy image 2"
    },
    {
      "type": "image_picker",
      "id": "gummy_image_3",
      "label": "Gummy image 3"
    },
    {
      "type": "checkbox",
      "id": "enable_floating",
      "label": "Enable floating animation",
      "default": true
    },
    {
      "type": "header",
      "content": "Disclaimer"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "info": "Shown under the timeline. Keep it — it frames every step honestly.",
      "default": "Individual experiences vary. No specific outcome at a specific time is promised."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Practical fact",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "period",
          "label": "Time period label",
          "info": "Keep it a loose range, not a promise date (e.g. \"Days 1–7\").",
          "default": "Weeks 2–3"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Outcome heading",
          "default": "Supporting consistency"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Supporting sentence",
          "default": "Your routine settles in. Some customers say the ritual itself becomes the first win."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None (dot)" },
            { "value": "clock", "label": "Clock" },
            { "value": "refresh", "label": "Refresh" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "moon", "label": "Moon" },
            { "value": "drop", "label": "Drop" },
            { "value": "check", "label": "Check" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smooch timeline",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "period": "Days 1–7",
            "heading": "Building the habit",
            "text": "You're learning where this fits in your day. That consistency is the foundation.",
            "icon": "clock"
          }
        },
        {
          "type": "step",
          "settings": {
            "period": "Weeks 2–3",
            "heading": "Supporting consistency",
            "text": "Your routine settles in. Some customers say the ritual itself becomes the first win.",
            "icon": "refresh"
          }
        },
        {
          "type": "step",
          "settings": {
            "period": "Weeks 4–6",
            "heading": "Noticing subtle shifts",
            "text": "With consistent use, some customers may notice their mood and presence feel more available.",
            "icon": "sparkle"
          }
        },
        {
          "type": "step",
          "settings": {
            "period": "Week 8+",
            "heading": "Reflecting",
            "text": "A good moment to check in with yourself on mood, desire, and connection — support may build gradually.",
            "icon": "heart"
          }
        }
      ]
    }
  ]
}
{% endschema %}
