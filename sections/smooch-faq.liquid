{{ 'section-smooch-faq.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign brand_name = settings.smooch_brand_name | default: shop.name

  assign faq_count = 0
  for block in section.blocks
    if block.settings.question != blank
      assign faq_count = faq_count | plus: 1
    endif
  endfor
-%}

<div class="smooch-band color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="smooch-faq">
      <header class="smooch-section-head smooch-faq__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="smooch-eyebrow smooch-eyebrow--accent">
            {{- section.settings.eyebrow | replace: '[brand]', brand_name -}}
          </p>
        {%- endif -%}
        <h2 class="smooch-h2">
          {{- section.settings.heading | replace: '[brand]', brand_name -}}
        </h2>
      </header>

      {%- if faq_count > 0 -%}
        <smooch-details-group class="smooch-accordion smooch-faq__list">
          {%- assign q_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- assign question = block.settings.question | replace: '[brand]', brand_name -%}
            {%- if question != blank -%}
              {%- assign q_index = q_index | plus: 1 -%}
              {%- assign q_display = q_index | prepend: '00' | slice: -2, 2 -%}
              <details id="Details-{{ block.id }}-{{ section.id }}" {{ block.shopify_attributes }}>
                <summary aria-controls="Accordion-{{ block.id }}-{{ section.id }}">
                  <span class="smooch-accordion__label smooch-faq__question">
                    <span class="smooch-faq__num smooch-num" aria-hidden="true">{{ q_display }}</span>
                    <span>{{ question }}</span>
                  </span>
                  {% render 'smooch-icon', icon: 'plus', class: 'smooch-icon--toggle' %}
                </summary>
                <div class="smooch-accordion__content" id="Accordion-{{ block.id }}-{{ section.id }}">
                  {{ block.settings.answer | replace: '[brand]', brand_name }}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </smooch-details-group>
      {%- endif -%}

      {%- if section.settings.closing_text != blank or section.settings.closing_link_label != blank -%}
        <footer class="smooch-faq__closing">
          {%- if section.settings.closing_text != blank -%}
            <p class="smooch-h3 smooch-faq__closing-text">
              {{- section.settings.closing_text | replace: '[brand]', brand_name -}}
            </p>
          {%- endif -%}
          {%- if section.settings.closing_link_label != blank and section.settings.closing_link != blank -%}
            <a class="smooch-btn smooch-btn--ghost" href="{{ section.settings.closing_link }}">
              {{ section.settings.closing_link_label | replace: '[brand]', brand_name }}
              {% render 'smooch-icon', icon: 'arrow-right', class: 'smooch-icon--sm' %}
            </a>
          {%- endif -%}
        </footer>
      {%- endif -%}
    </div>
  </div>
</div>

{%- if faq_count > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign printed = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank -%}
            {%- if printed > 0 -%},{%- endif -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | replace: '[brand]', brand_name | strip_html | strip | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | replace: '[brand]', brand_name | strip_html | strip | json }}
              }
            }
            {%- assign printed = printed | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Smooch FAQ",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 16,
  "settings": [
    {
      "type": "paragraph",
      "content": "A narrow editorial FAQ. Rows open one at a time, and the questions are published as FAQ structured data for search engines automatically."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Good questions",
      "info": "Use [brand] to insert the brand name."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything you're wondering",
      "info": "Use [brand] to insert the brand name."
    },
    {
      "type": "header",
      "content": "Closing call to action",
      "info": "Hides when both texts are empty."
    },
    {
      "type": "text",
      "id": "closing_text",
      "label": "Closing text",
      "default": "Still curious?",
      "info": "Use [brand] to insert the brand name."
    },
    {
      "type": "text",
      "id": "closing_link_label",
      "label": "Link label",
      "default": "Talk to us"
    },
    {
      "type": "url",
      "id": "closing_link",
      "label": "Link",
      "default": "/pages/contact"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Is it right for me?",
          "info": "Use [brand] to insert the brand name."
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Write a warm, honest answer here. Keep claims gentle — “formulated to support”, “experiences vary” — and point medical questions to a qualified healthcare professional.</p>",
          "info": "Use [brand] to insert the brand name. This text also feeds the FAQ structured data."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smooch FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What is [brand]?",
            "answer": "<p>[brand] is a daily gummy formulated to support desire, mood, and connection — a small everyday ritual, not a quick fix. As with any supplement, experiences vary.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Who is it for?",
            "answer": "<p>Women who want to make a little daily space for desire, mood, and confidence. It's a wellness supplement, not a treatment — if you have a specific health concern, a qualified healthcare professional is the right first stop.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do I take it?",
            "answer": "<p>Take the recommended serving once a day — you'll find the exact serving size on the label. With or without food, whichever suits you.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "When should I take it?",
            "answer": "<p>Whenever you'll actually remember it. Most people anchor it to something they already do — morning coffee, the evening wind-down. Consistency matters more than the clock.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long should I use it?",
            "answer": "<p>[brand] is designed for consistent, ongoing use. Give it several consistent weeks before you judge it, then check in with how you feel. Experiences vary — some people notice subtle shifts sooner than others.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What's inside?",
            "answer": "<p>Every ingredient is listed in the formula section on our product page, and the final ingredient list always appears on the label — no hidden blends.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I combine it with other supplements?",
            "answer": "<p>That depends on what else you're taking. Before combining [brand] with other supplements, talk with a qualified healthcare professional who can look at your full routine.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I use it while pregnant or breastfeeding?",
            "answer": "<p>Do not use [brand] while pregnant or breastfeeding without talking to a qualified healthcare professional first.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I take it with medication?",
            "answer": "<p>If you take any medication, talk with a qualified healthcare professional before starting [brand]. They know your full picture — we don't.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How does the subscription work?",
            "answer": "<p>Choose a delivery schedule at checkout and your order arrives automatically, with any subscription savings applied to each delivery. You stay in control and can manage or cancel at any time.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do I cancel?",
            "answer": "<p>Anytime, in a couple of clicks — use the manage link in your order emails, or message our support team and we'll take care of it. No hoops, no guilt.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What's the return policy?",
            "answer": "<p>Returns and refunds are handled under our refund policy — you’ll find the full details linked in the footer, and our support team is happy to help.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Where is it made?",
            "answer": "<p>Add your manufacturing details here.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
