{{ 'section-smooch-ugc-gallery.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign brand_name = settings.smooch_brand_name | default: shop.name
-%}

<div class="smooch-band color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.lead != blank -%}
      <header class="smooch-section-head smooch-ugc-gallery__head">
        <div class="smooch-ugc-gallery__head-copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="smooch-eyebrow smooch-eyebrow--accent">
              {{- section.settings.eyebrow | replace: '[brand]', brand_name -}}
            </p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="smooch-h2">
              {{- section.settings.heading | replace: '[brand]', brand_name -}}
            </h2>
          {%- endif -%}
        </div>
        {%- if section.settings.lead != blank -%}
          <p class="smooch-lead smooch-ugc-gallery__lead">
            {{- section.settings.lead | replace: '[brand]', brand_name -}}
          </p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="smooch-scroller smooch-scroller--desktop-grid smooch-ugc-gallery__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign caption = block.settings.caption | replace: '[brand]', brand_name
            assign handle = block.settings.handle | strip
            assign alt_text = block.settings.alt | default: block.settings.image.alt | default: caption
          -%}
          <li class="smooch-ugc-gallery__item" {{ block.shopify_attributes }}>
            <figure class="smooch-ugc-gallery__card">
              <div class="smooch-ugc-gallery__media">
                {%- if block.settings.image != blank -%}
                  {%- if forloop.first -%}
                    {{
                      block.settings.image
                      | image_url: width: 1500
                      | image_tag:
                        loading: 'lazy',
                        widths: '375, 550, 750, 1100, 1500',
                        sizes: '(min-width: 1200px) 560px, (min-width: 990px) 48vw, 72vw',
                        class: 'smooch-ugc-gallery__img',
                        alt: alt_text
                    }}
                  {%- else -%}
                    {{
                      block.settings.image
                      | image_url: width: 1100
                      | image_tag:
                        loading: 'lazy',
                        widths: '375, 550, 750, 1100',
                        sizes: '(min-width: 1200px) 280px, (min-width: 990px) 24vw, 72vw',
                        class: 'smooch-ugc-gallery__img',
                        alt: alt_text
                    }}
                  {%- endif -%}
                {%- elsif forloop.index <= 5 -%}
                  {%- comment -%}
                    Bundled brand-shot fallbacks (product placed in real-life
                    scenes) used until the merchant uploads their own UGC —
                    same fallback pattern as the formula/science sections.
                  {%- endcomment -%}
                  <img
                    src="{{ 'smooch-ugc-' | append: forloop.index | append: '.jpg' | asset_url }}"
                    width="800"
                    height="994"
                    loading="lazy"
                    class="smooch-ugc-gallery__img"
                    alt="{{ alt_text | default: caption | escape }}"
                  >
                {%- else -%}
                  <div class="smooch-ugc-gallery__placeholder" aria-hidden="true">
                    {{ 'image' | placeholder_svg_tag: 'smooch-ugc-gallery__placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>

              {%- if caption != blank or handle != blank -%}
                <figcaption class="smooch-ugc-gallery__caption">
                  {%- if caption != blank -%}
                    <span class="smooch-ugc-gallery__caption-text">{{ caption | escape }}</span>
                  {%- endif -%}
                  {%- if handle != blank -%}
                    <span class="smooch-ugc-gallery__handle">{{ handle | replace: '[brand]', brand_name | escape }}</span>
                  {%- endif -%}
                </figcaption>
              {%- endif -%}
            </figure>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="smooch-fine-print smooch-ugc-gallery__note">
        {{- section.settings.note | replace: '[brand]', brand_name | escape -}}
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Smooch UGC gallery",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "paragraph",
      "content": "Only use images you own or have permission to use. Replace placeholders before launch."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "In the wild",
      "info": "Use [brand] to insert your brand name."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Little rituals, real life",
      "info": "Use [brand] to insert your brand name."
    },
    {
      "type": "text",
      "id": "lead",
      "label": "Lead text",
      "default": "Slow mornings, wind-down evenings, and the little rituals in between.",
      "info": "Optional. Use [brand] to insert your brand name."
    },
    {
      "type": "header",
      "content": "Gallery note"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Fine-print note",
      "default": "Sample gallery for layout only — swap in photos you own or have permission to feature.",
      "info": "Shown under the gallery. Clear it once your own photos and permissions are in place."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Square or portrait crops work best. Leave empty to show a placeholder while you gather photos."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description (alt text)",
          "info": "Describes the image for screen readers. Falls back to the image's own alt text, then the caption."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "A quiet ritual moment",
          "info": "Shown over the image. Use [brand] to insert your brand name."
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Handle",
          "info": "Optional, e.g. “@maya.likes”. Only feature a handle with the creator's permission."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smooch UGC gallery",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "caption": "Morning ritual"
          }
        },
        {
          "type": "image",
          "settings": {
            "caption": "The nightstand edit",
            "handle": "@sample.handle"
          }
        },
        {
          "type": "image",
          "settings": {
            "caption": "Sunday reset"
          }
        },
        {
          "type": "image",
          "settings": {
            "caption": "Tucked into the travel bag"
          }
        },
        {
          "type": "image",
          "settings": {
            "caption": "Golden hour wind-down"
          }
        }
      ]
    }
  ]
}
{% endschema %}
