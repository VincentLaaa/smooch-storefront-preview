{{ 'section-smooch-why.css' | asset_url | stylesheet_tag }}
<script src="{{ 'smooch-why.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.7 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign brand_name = settings.smooch_brand_name | default: shop.name
  assign slide_blocks = section.blocks | where: 'type', 'slide'
-%}

<div class="smooch-band smooch-why color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="smooch-why__layout">
      <div class="smooch-why__visual">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '450, 700, 900',
              sizes: '(min-width: 990px) 44vw, 90vw',
              class: 'smooch-why__img',
              alt: section.settings.image.alt | default: brand_name
          }}
        {%- else -%}
          {%- comment -%}
            Bundled product-in-use photo used until the merchant uploads
            their own — same fallback pattern as the other bundled visuals.
          {%- endcomment -%}
          <img
            src="{{ 'smooch-why-hand.jpg' | asset_url }}"
            width="900"
            height="900"
            loading="lazy"
            class="smooch-why__img"
            alt="{{ brand_name }} bottle held in hand"
          >
        {%- endif -%}
      </div>

      <div class="smooch-why__content" data-smooch-why>
        {%- if section.settings.heading != blank -%}
          <h2 class="smooch-h2 smooch-why__heading">
            {{- section.settings.heading | replace: '[brand]', brand_name | escape -}}
          </h2>
        {%- endif -%}

        {%- if slide_blocks.size > 0 -%}
          <p class="smooch-why__counter smooch-caption" aria-live="polite">
            Slide <span data-why-current>1</span> of {{ slide_blocks.size }}
          </p>

          <div class="smooch-why__track" data-why-track tabindex="0" role="region" aria-label="Reasons to choose {{ brand_name }}">
            {%- for block in slide_blocks -%}
              <div class="smooch-why__slide" {{ block.shopify_attributes }}>
                <span class="smooch-why__icon">
                  {%- render 'smooch-icon', icon: block.settings.icon, class: 'smooch-icon--lg' -%}
                </span>
                {%- if block.settings.title != blank -%}
                  <h3 class="smooch-why__slide-title">{{ block.settings.title | replace: '[brand]', brand_name | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="smooch-why__slide-text">{{ block.settings.text | replace: '[brand]', brand_name | escape }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if slide_blocks.size > 1 -%}
            <div class="smooch-why__arrows">
              <button type="button" class="smooch-why__arrow" data-why-prev aria-label="Previous slide">
                {% render 'smooch-icon', icon: 'arrow-left', class: 'smooch-icon--sm' %}
              </button>
              <button type="button" class="smooch-why__arrow" data-why-next aria-label="Next slide">
                {% render 'smooch-icon', icon: 'arrow-right', class: 'smooch-icon--sm' %}
              </button>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Smooch why us",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "\"Why women choose [brand]\" slider: product-in-use photo beside one value-prop slide at a time (icon, title, short paragraph) so the page never shows a wall of text."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why women choose [brand]",
      "info": "Use [brand] to insert the brand name."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Product-in-use photo shown beside the slides. Leave blank for the bundled photo."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "star", "label": "Star" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "user", "label": "Person" },
            { "value": "clock", "label": "Clock" },
            { "value": "refresh", "label": "Refresh" }
          ],
          "default": "heart"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Risk-Free Guarantee" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Try [brand] risk-free with our 30-day money-back guarantee. If you don't love the way you feel, we'll make it right. No questions asked."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smooch why us",
      "blocks": [
        { "type": "slide", "settings": { "icon": "shield", "title": "Risk-Free Guarantee", "text": "Try [brand] risk-free with our 30-day money-back guarantee. If you don't love the way you feel, we'll make it right. No questions asked." } },
        { "type": "slide", "settings": { "icon": "star", "title": "Real Answers From Real Women", "text": "82% of women say they feel more like themselves again. 3x more nights that end closer, not just tired. These aren't just claims — they're what women tell us after making [brand] a daily ritual." } },
        { "type": "slide", "settings": { "icon": "leaf", "title": "Four Ingredients, Nothing Hidden", "text": "Every ingredient is named on the label: KSM-66 Ashwagandha — the most-studied form — plus Black Maca, Damiana, and Cinnamon Bark. No proprietary blends, no guesswork, nothing to decode." } },
        { "type": "slide", "settings": { "icon": "heart", "title": "Tastes Like a Treat, Works Like a Ritual", "text": "Unlike capsules that sit unused in the cabinet, one soft watermelon gummy makes daily support something you actually look forward to. A treat, not a task." } },
        { "type": "slide", "settings": { "icon": "sparkle", "title": "Made for Women, By People Who Get It", "text": "We built [brand] because generic supplements were never made for this season of life. Every choice is designed around women's mood, desire, and connection — softly, daily." } },
        { "type": "slide", "settings": { "icon": "user", "title": "Trusted by 100k+ Women", "text": "You're not alone in this. Join the women who stopped waiting for the spark to come back on its own — and made a small daily ritual of it instead." } }
      ]
    }
  ]
}
{% endschema %}
