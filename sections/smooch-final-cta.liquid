{{ 'section-smooch-final-cta.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign brand_name = settings.smooch_brand_name | default: shop.name
  assign product = section.settings.product
  assign guarantee_days = settings.smooch_guarantee_days | default: 0

  assign cta_url = section.settings.cta_link
  if cta_url == blank and product != blank
    assign cta_url = product.url
  endif
  if cta_url == blank
    assign cta_url = routes.all_products_collection_url
  endif

-%}

<div class="smooch-band smooch-final-cta color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <header class="smooch-final-cta__head smooch-center">
      <h2 class="smooch-display smooch-final-cta__headline">
        {{- section.settings.headline | replace: '[brand]', brand_name -}}
      </h2>
      {%- if section.settings.subline != blank -%}
        <p class="smooch-lead smooch-final-cta__subline">
          {{- section.settings.subline | replace: '[brand]', brand_name | escape -}}
        </p>
      {%- endif -%}
    </header>

    <div class="smooch-final-cta__cta smooch-center">
      <a href="{{ cta_url }}" class="smooch-btn smooch-btn--berry smooch-btn--lg smooch-final-cta__btn">
        {{- section.settings.cta_label | default: 'Shop now' | replace: '[brand]', brand_name | escape -}}
      </a>
    </div>

    <ul class="smooch-final-cta__chips" role="list">
      {%- if guarantee_days > 0 -%}
        <li class="smooch-final-cta__chip">
          {% render 'smooch-icon', icon: 'shield', class: 'smooch-icon--sm' %}
          <span>
            {{- guarantee_days }}-day
            {{ settings.smooch_guarantee_text | default: 'money-back guarantee' | escape -}}
          </span>
        </li>
      {%- endif -%}
      {%- if section.settings.chip_shipping != blank -%}
        <li class="smooch-final-cta__chip">
          {% render 'smooch-icon', icon: 'truck', class: 'smooch-icon--sm' %}
          <span>{{ section.settings.chip_shipping | replace: '[brand]', brand_name | escape }}</span>
        </li>
      {%- endif -%}
      {%- if section.settings.chip_trust != blank -%}
        <li class="smooch-final-cta__chip">
          {% render 'smooch-icon', icon: 'user', class: 'smooch-icon--sm' %}
          <span>{{ section.settings.chip_trust | replace: '[brand]', brand_name | escape }}</span>
        </li>
      {%- endif -%}
    </ul>

    {%- if settings.smooch_supplement_disclaimer != blank -%}
      <div class="smooch-final-cta__fine-print smooch-fine-print">
        {{ settings.smooch_supplement_disclaimer }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Smooch final CTA",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "The emotional closing statement for landing and home pages: an oversized headline, a short supporting paragraph, one clear call to action, and a row of trust chips."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "inline_richtext",
      "id": "headline",
      "label": "Headline",
      "default": "Come back to the version of you that feels connected.",
      "info": "An alternative that also works well: “Less pressure. More possibility.” Use [brand] to insert your brand name."
    },
    {
      "type": "textarea",
      "id": "subline",
      "label": "Supporting paragraph",
      "default": "One gummy a day. A little more you.",
      "info": "Use [brand] to insert your brand name."
    },
    {
      "type": "header",
      "content": "Trust chips"
    },
    {
      "type": "paragraph",
      "content": "The guarantee chip comes from Theme settings → Trust and reassurance and hides automatically while the guarantee length is set to 0."
    },
    {
      "type": "text",
      "id": "chip_shipping",
      "label": "Shipping chip",
      "default": "Free shipping on subscriptions"
    },
    {
      "type": "text",
      "id": "chip_trust",
      "label": "Trust chip",
      "default": "Trusted by 100k+ women"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "The button links to this product's page. A catalog link is used until one is chosen."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Meet [brand]",
      "info": "Use [brand] to insert your brand name."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Optional. Leave empty to link to the selected product (or to your catalog until one is chosen)."
    },
    {
      "type": "paragraph",
      "content": "The supplement disclaimer from Theme settings → Compliance renders as fine print at the bottom of this section."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Smooch final CTA",
      "settings": {
        "color_scheme": "scheme-4",
        "headline": "Come back to the version of you that feels connected.",
        "subline": "One gummy a day. A little more you.",
        "cta_label": "Meet [brand]"
      }
    }
  ]
}
{% endschema %}
