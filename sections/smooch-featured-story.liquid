{{ 'section-smooch-featured-story.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      --story-pad-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign brand_name = settings.smooch_brand_name | default: shop.name

  assign eyebrow_text = section.settings.eyebrow | replace: '[brand]', brand_name
  assign quote_text = section.settings.quote | replace: '[brand]', brand_name
  assign attribution_text = section.settings.attribution

  comment
    Honest labeling: while "Show story label" is on, a label always renders,
    falling back to sample wording if the label field is emptied. With it off,
    a non-empty label still renders; only unchecking AND clearing the label
    hides it — so sample copy cannot silently pass as real proof.
  endcomment
  assign story_label = section.settings.verified_label | strip
  assign show_story_label = false
  if section.settings.show_sample_label
    assign show_story_label = true
    if story_label == blank
      assign story_label = 'Sample story — replace with a real customer story'
    endif
  elsif story_label != blank
    assign show_story_label = true
  endif

  assign image_alt = section.settings.image_alt | default: section.settings.image.alt | escape
-%}

<div class="smooch-band color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="smooch-featured-story">
      <div class="smooch-featured-story__content">
        {%- if eyebrow_text != blank -%}
          <h2 class="smooch-eyebrow smooch-eyebrow--accent smooch-featured-story__eyebrow">
            {{- eyebrow_text | escape -}}
          </h2>
        {%- endif -%}

        <figure class="smooch-featured-story__figure">
          {% render 'smooch-icon', icon: 'quote', class: 'smooch-featured-story__quote-icon' %}
          {%- if quote_text != blank -%}
            <blockquote class="smooch-quote smooch-featured-story__quote">
              <p>{{ quote_text | escape | newline_to_br }}</p>
            </blockquote>
          {%- endif -%}
          {%- if attribution_text != blank -%}
            <figcaption class="smooch-quote-attribution smooch-featured-story__attribution">
              {{- attribution_text | escape -}}
            </figcaption>
          {%- endif -%}
        </figure>

        {%- if show_story_label -%}
          <p class="smooch-caption smooch-featured-story__label">
            {% render 'smooch-icon', icon: 'info', class: 'smooch-icon--sm' %}
            <span>{{ story_label | escape }}</span>
          </p>
        {%- endif -%}
      </div>

      <div class="smooch-featured-story__media-col">
        <div class="smooch-media smooch-featured-story__media">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1500
              | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750, 1100, 1500',
                sizes: '(min-width: 990px) 42vw, (min-width: 750px) 52rem, 100vw',
                alt: image_alt
            }}
          {%- else -%}
            {%- comment -%}
              Bundled portrait fallback until the merchant uploads a real
              customer photo — same pattern as the other bundled visuals.
            {%- endcomment -%}
            <img
              src="{{ 'smooch-story-portrait.jpg' | asset_url }}"
              width="900"
              height="1222"
              loading="lazy"
              class="smooch-featured-story__img"
              alt="{{ image_alt | default: section.settings.attribution | escape }}"
            >
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Smooch featured story",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Story"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "In her words",
      "info": "Use [brand] to insert the brand name."
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "I didn't need a different life. I needed to feel like me again in the one I have. This little ritual became the moment I check back in with myself.",
      "info": "First-person, in the customer's own words. Keep it about feelings and rituals — never medical outcomes. Use [brand] to insert the brand name."
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution",
      "default": "Maya, 38"
    },
    {
      "type": "header",
      "content": "Honest labeling"
    },
    {
      "type": "paragraph",
      "content": "The default story is sample copy. Keep the label below until you replace it with a real customer's story, shared with their permission."
    },
    {
      "type": "checkbox",
      "id": "show_sample_label",
      "label": "Show story label",
      "default": true,
      "info": "While checked, the label always shows (with fallback sample wording if the field is emptied). To remove it entirely, uncheck this and clear the label text — only once the story above is real."
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Story label",
      "default": "Sample story — replace with a real customer story",
      "info": "Once the story is real, change this to something true, e.g. “Shared with permission”."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional portrait or lifestyle image. On desktop it sits offset, hanging slightly past the band edge. A soft placeholder shows until an image is chosen."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Describes the image for screen readers. Leave empty to use the image's own alt text."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Smooch featured story"
    }
  ]
}
{% endschema %}
