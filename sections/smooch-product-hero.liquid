{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{{ 'smooch-product.css' | asset_url | stylesheet_tag }}

{% unless product.has_only_default_variant %}
  {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
  {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
  {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
{% endunless %}

<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'smooch-product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'smooch-product-gallery.js' | asset_url }}" defer="defer"></script>

{% if section.settings.image_zoom == 'hover' %}
  <script id="EnableZoomOnHover-{{ section.id }}" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
{% endif %}
{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
{%- if first_3d_model -%}
  {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
  <link
    id="ModelViewerStyle"
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  >
  <link
    id="ModelViewerOverride"
    rel="stylesheet"
    href="{{ 'component-model-viewer-ui.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if section.settings.use_media_background %}
    {%- comment -%}
      Gallery hero canvas: when the merchant's imagery has a baked-in
      background color, matching it here makes the image -> page transition
      invisible (Neutonic treatment). Off by default so transparent-cutout
      imagery floats directly on the section background.
    {%- endcomment %}
    #MainProduct-{{ section.id }} {
      --smooch-media-bg: {{ section.settings.media_background }};
    }
  {%- endif %}
{%- endstyle -%}

{%- liquid
  assign brand_name = settings.smooch_brand_name | default: shop.name

  assign bundle_blocks = section.blocks | where: 'type', 'bundle'
  assign gift_blocks = section.blocks | where: 'type', 'gift'
  assign rating_blocks = section.blocks | where: 'type', 'rating'
  assign rating_block = rating_blocks.first
  assign title_blocks = section.blocks | where: 'type', 'title'
  assign title_block = title_blocks.first
  assign display_title = product.title
  if title_block.settings.custom_title != blank
    assign display_title = title_block.settings.custom_title | replace: '[brand]', brand_name
  endif
  assign subscription_blocks = section.blocks | where: 'type', 'subscription'
  assign subscription_block = subscription_blocks.first
  assign buy_buttons_blocks = section.blocks | where: 'type', 'buy_buttons'
  assign buy_buttons_block = buy_buttons_blocks.first
  assign has_bundles = false
  if bundle_blocks.size > 0
    assign has_bundles = true
  endif

  assign has_plans = false
  if product.selling_plan_groups.size > 0
    assign has_plans = true
  endif

  assign current_variant = product.selected_or_first_available_variant

  assign offer_ui = false
  if has_bundles or has_plans
    assign offer_ui = true
  endif

  comment
    Default bundle: first block marked preselected, else the first bundle block.
    Resolved before plan lookup below — each bundle carries its own real
    selling plan (different tiers ship at different real-world discounts and
    intervals, e.g. "1 tub / every 1 month" vs "3 tubs / every 3 months" — a
    single uniform percentage-off plan can't represent that), so which plan
    is "the" plan depends on which bundle is selected.
  endcomment
  assign default_bundle_index = 0
  assign default_bundle_qty = 1
  for block in bundle_blocks
    if block.settings.preselected
      assign default_bundle_index = forloop.index0
      assign default_bundle_qty = block.settings.quantity | at_least: 1
      break
    endif
  endfor
  if default_bundle_index == 0 and bundle_blocks.size > 0
    assign first_bundle = bundle_blocks | first
    unless first_bundle.settings.preselected
      assign default_bundle_qty = first_bundle.settings.quantity | at_least: 1
    endunless
  endif

  comment
    Subscription-first default (Create-style): when plans exist and the
    subscription block opts in (default), the selected bundle's own plan
    starts selected and one-time becomes the secondary choice.
  endcomment
  assign subscription_block = section.blocks | where: 'type', 'subscription' | first
  assign default_is_subscribe = false
  assign default_plan = nil
  if has_plans and subscription_block
    assign default_purchase_pref = subscription_block.settings.default_purchase | default: 'subscribe'
    if default_purchase_pref == 'subscribe'
      assign default_is_subscribe = true
      assign default_bundle_plan_id = bundle_blocks[default_bundle_index].settings.selling_plan_id | append: ''
      for group in product.selling_plan_groups
        for plan in group.selling_plans
          assign plan_id_str = plan.id | append: ''
          if plan_id_str == default_bundle_plan_id
            assign default_plan = plan
            break
          endif
        endfor
        if default_plan
          break
        endif
      endfor
      comment
        Fall back to the first real plan if no bundle-specific match is configured.
      endcomment
      if default_plan == nil
        assign default_plan = product.selling_plan_groups[0].selling_plans[0]
      endif
    endif
  endif

  assign default_unit_price = current_variant.price
  if default_is_subscribe and default_plan
    for alloc in current_variant.selling_plan_allocations
      if alloc.selling_plan.id == default_plan.id
        assign default_unit_price = alloc.price
      endif
    endfor
  endif
-%}

<product-info
  id="MainProduct-{{ section.id }}"
  class="smooch-product section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {%- if product != blank -%}
    {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
    <product-component view-event-payload="{{ product | standard_event_data: 'view', context: 'page' | escape }}">
      <div class="page-width">
        <div class="product product--{{ section.settings.media_size }} product--left product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %} smooch-product__layout">
          <div
            class="grid__item product__media-wrapper smooch-product__gallery{% if section.settings.enable_sticky_info %} smooch-product__gallery--sticky{% endif %}"
            data-smooch-gallery
          >
            {%- liquid
              assign lazy_gallery = false
              if section.settings.eager_first_image == false
                assign lazy_gallery = true
              endif
            -%}
            <div class="smooch-gallery__canvas">
              {% render 'product-media-gallery', variant_images: variant_images, lazy_load_all: lazy_gallery %}
              {%- if section.settings.show_gallery_arrows and product.media.size > 1 -%}
                <button
                  type="button"
                  class="smooch-gallery__arrow smooch-gallery__arrow--prev"
                  data-gallery-prev
                  aria-label="{{ 'general.slider.previous_slide' | t }}"
                >
                  {% render 'smooch-icon', icon: 'arrow-left', class: 'smooch-icon--sm' %}
                </button>
                <button
                  type="button"
                  class="smooch-gallery__arrow smooch-gallery__arrow--next"
                  data-gallery-next
                  aria-label="{{ 'general.slider.next_slide' | t }}"
                >
                  {% render 'smooch-icon', icon: 'arrow-right', class: 'smooch-icon--sm' %}
                </button>
              {%- endif -%}
            </div>
            {%- if section.settings.show_gallery_dots and product.media.size > 1 -%}
              <div class="smooch-gallery__dots" data-gallery-dots aria-label="Gallery pagination"></div>
            {%- endif -%}

            {%- comment -%}
              Branded informational media cards (Lemme-style): merchant-authored
              benefit/formula/ritual cards presented as a swipeable rail under
              the gallery. Cards with no content are skipped entirely.
            {%- endcomment -%}
            {%- assign media_card_blocks = section.blocks | where: 'type', 'media_card' -%}
            {%- assign has_media_cards = false -%}
            {%- for card in media_card_blocks -%}
              {%- if card.settings.heading != blank or card.settings.image != blank -%}
                {%- assign has_media_cards = true -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if has_media_cards -%}
              <ul class="smooch-media-cards" role="list" aria-label="Product highlights">
                {%- for card in media_card_blocks -%}
                  {%- if card.settings.heading != blank or card.settings.image != blank -%}
                    <li class="smooch-media-card smooch-media-card--{{ card.settings.palette }}" {{ card.shopify_attributes }}>
                      {%- if card.settings.image != blank -%}
                        <div class="smooch-media-card__image">
                          {{ card.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900', sizes: '(min-width: 990px) 24vw, 72vw', alt: card.settings.image.alt | default: card.settings.heading }}
                        </div>
                      {%- endif -%}
                      <div class="smooch-media-card__body">
                        {%- if card.settings.kicker != blank -%}
                          <p class="smooch-media-card__kicker">{{ card.settings.kicker | escape }}</p>
                        {%- endif -%}
                        {%- if card.settings.heading != blank -%}
                          <p class="smooch-media-card__heading">{{ card.settings.heading | escape }}</p>
                        {%- endif -%}
                        {%- if card.settings.text != blank -%}
                          <div class="smooch-media-card__text">{{ card.settings.text }}</div>
                        {%- endif -%}
                      </div>
                      <span class="smooch-media-card__shape" aria-hidden="true"></span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

          <div class="product__info-wrapper grid__item smooch-product__panel">
            <section
              id="ProductInfo-{{ section.id }}"
              class="product__info-container smooch-buybox{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
            >
              {%- assign product_form_id = 'product-form-' | append: section.id -%}

              <smooch-offer
                class="smooch-offer"
                data-section-id="{{ section.id }}"
                data-current-variant="{{ current_variant.id }}"
                data-default-bundle="{{ default_bundle_index }}"
                data-save-template="Save [percent]%"
              >
                {%- comment -%} Form-associated controls driven by the offer UI. {%- endcomment -%}
                {%- if has_bundles -%}
                  <input
                    type="hidden"
                    name="quantity"
                    value="{{ default_bundle_qty }}"
                    form="{{ product_form_id }}"
                    data-smooch-quantity
                  >
                {%- endif -%}
                {%- if has_plans -%}
                  <input
                    type="hidden"
                    name="selling_plan"
                    value="{% if default_is_subscribe %}{{ default_plan.id }}{% endif %}"
                    form="{{ product_form_id }}"
                    {% unless default_is_subscribe %}disabled{% endunless %}
                    data-smooch-selling-plan
                  >
                {%- endif -%}

                {%- assign benefits_rendered = false -%}
                {%- for block in section.blocks -%}
                  {%- case block.type -%}
                    {%- when '@app' -%}
                      {% render block %}

                    {%- when 'eyebrow' -%}
                      {%- if block.settings.text != blank -%}
                        <p class="smooch-eyebrow smooch-eyebrow--accent smooch-buybox__eyebrow" {{ block.shopify_attributes }}>
                          {{ block.settings.text | replace: '[brand]', brand_name }}
                        </p>
                      {%- endif -%}

                    {%- when 'title' -%}
                      {%- liquid
                        assign title_tag = block.settings.heading_level | default: 'h1'
                      -%}
                      <{{ title_tag }} class="smooch-h2 smooch-buybox__title" {{ block.shopify_attributes }}>
                        {%- if block.settings.custom_title != blank -%}
                          {{ block.settings.custom_title | replace: '[brand]', brand_name }}
                        {%- else -%}
                          {{ product.title | escape }}
                        {%- endif -%}
                      </{{ title_tag }}>

                    {%- when 'rating' -%}
                      <div class="smooch-buybox__rating" {{ block.shopify_attributes }}>
                        {% render 'smooch-rating',
                          product: product,
                          fallback_rating: block.settings.fallback_rating,
                          fallback_count: block.settings.fallback_count,
                          show_sample_label: false,
                          link: block.settings.link_to_reviews
                        %}
                      </div>

                    {%- when 'social_proof' -%}
                      <div class="smooch-buybox__proof-row" {{ block.shopify_attributes }}>
                        {%- if block.settings.sold_count != blank -%}
                          <p class="smooch-sold-badge">
                            <strong class="smooch-sold-badge__count">{{ block.settings.sold_count | escape }}</strong>
                            <span>{{ block.settings.period_label | default: 'bought in the past month' | escape }}</span>
                          </p>
                        {%- endif -%}
                        {%- if block.settings.show_low_stock and current_variant.inventory_management == 'shopify' and current_variant.inventory_policy != 'continue' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= block.settings.low_stock_threshold -%}
                          <p class="smooch-stock-badge">
                            {% render 'smooch-icon', icon: 'check', class: 'smooch-icon--sm' %}
                            <span>Selling fast</span>
                          </p>
                        {%- endif -%}
                      </div>

                    {%- when 'promise' -%}
                      {%- if block.settings.text != blank -%}
                        <p class="smooch-lead smooch-buybox__promise" {{ block.shopify_attributes }}>
                          {{ block.settings.text | replace: '[brand]', brand_name }}
                        </p>
                      {%- endif -%}

                    {%- when 'benefit' -%}
                      {%- unless benefits_rendered -%}
                        {%- assign benefits_rendered = true -%}
                        {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
                        <ul class="smooch-ticks smooch-buybox__benefits" role="list">
                          {%- for benefit_block in benefit_blocks -%}
                            {%- if benefit_block.settings.text != blank -%}
                              {% render 'smooch-benefit-item',
                                icon: benefit_block.settings.icon,
                                text: benefit_block.settings.text,
                                attrs: benefit_block.shopify_attributes
                              %}
                            {%- endif -%}
                          {%- endfor -%}
                        </ul>
                      {%- endunless -%}

                    {%- when 'flavor' -%}
                      {%- if block.settings.text != blank -%}
                        <p class="smooch-buybox__flavor" {{ block.shopify_attributes }}>
                          <span class="smooch-flavor-pill">{{ block.settings.text | escape }}</span>
                        </p>
                      {%- endif -%}

                    {%- when 'variant_picker' -%}
                      <div class="smooch-buybox__variants" {{ block.shopify_attributes }}>
                        {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
                      </div>

                    {%- when 'bundles' -%}
                      {%- if has_bundles -%}
                        <fieldset class="smooch-bundles" {{ block.shopify_attributes }}>
                          <legend class="smooch-bundles__legend smooch-step">
                            <span class="smooch-step__num" aria-hidden="true">1</span>
                            {{ block.settings.heading | default: 'Select Your Size' }}:
                          </legend>
                          <div class="smooch-bundles__list" role="radiogroup" aria-label="{{ block.settings.heading | default: 'Select Your Size' | escape }}">
                            {%- for bundle_block in bundle_blocks -%}
                              {% render 'smooch-bundle-option',
                                block: bundle_block,
                                index: forloop.index0,
                                section_id: section.id,
                                product: product,
                                current_variant: current_variant,
                                checked_index: default_bundle_index
                              %}
                            {%- endfor -%}
                          </div>

                          {%- if gift_blocks.size > 0 -%}
                            {%- assign default_tier = default_bundle_index | plus: 1 -%}
                            <div class="smooch-gifts">
                              {%- for gift_block in gift_blocks -%}
                                {%- if gift_block.settings.title != blank -%}
                                  <div
                                    class="smooch-gift"
                                    data-smooch-gift
                                    data-tier="{{ gift_block.settings.tier }}"
                                    {{ gift_block.shopify_attributes }}
                                  >
                                    <div class="smooch-gift__media">
                                      {%- if gift_block.settings.image != blank -%}
                                        {{ gift_block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', sizes: '6rem', class: 'smooch-gift__img', alt: gift_block.settings.title }}
                                      {%- else -%}
                                        {% render 'smooch-icon', icon: 'gift', class: 'smooch-icon--lg' %}
                                      {%- endif -%}
                                    </div>
                                    <div class="smooch-gift__body">
                                      <p class="smooch-gift__title">
                                        {{ gift_block.settings.title }}
                                        {%- if gift_block.settings.value != blank -%}
                                          <span class="smooch-gift__value">({{ gift_block.settings.value }} value)</span>
                                        {%- endif -%}
                                      </p>
                                      <p class="smooch-gift__state">
                                        <span data-gift-included{% if default_tier < gift_block.settings.tier %} hidden{% endif %}>
                                          {% render 'smooch-icon', icon: 'check', class: 'smooch-icon--sm' %}
                                          Included with your selection
                                        </span>
                                        <span data-gift-locked{% unless default_tier < gift_block.settings.tier %} hidden{% endunless %}>
                                          {{ gift_block.settings.unlock_text | default: 'Included with larger bundles' }}
                                        </span>
                                      </p>
                                    </div>
                                  </div>
                                {%- endif -%}
                              {%- endfor -%}
                            </div>
                          {%- endif -%}
                        </fieldset>
                      {%- endif -%}

                    {%- when 'subscription' -%}
                      {%- if has_plans -%}
                        {%- liquid
                          comment
                            Create-style featured subscription panel: one primary
                            offer card carrying the real selected-plan economics,
                            frequency pills inside it, one-time as the secondary
                            row beneath. All figures Liquid-derived.
                          endcomment
                          assign initial_onetime_total = current_variant.price | times: default_bundle_qty
                          assign onetime_compare_total = current_variant.compare_at_price | default: 0 | times: default_bundle_qty
                          assign onetime_per_day = 0
                          assign panel_plan = default_plan
                          assign panel_unit = current_variant.price
                          for alloc in current_variant.selling_plan_allocations
                            if alloc.selling_plan.id == panel_plan.id
                              assign panel_unit = alloc.price
                            endif
                          endfor
                          assign panel_total = panel_unit | times: default_bundle_qty
                          assign panel_save = initial_onetime_total | minus: panel_total
                          assign panel_pct = 0
                          if panel_save > 0
                            assign panel_pct_amt = panel_save | times: 100
                            assign panel_pct = panel_pct_amt | divided_by: initial_onetime_total | round
                          endif
                          assign panel_bundle = bundle_blocks[default_bundle_index]
                          assign panel_days = panel_bundle.settings.days | default: 0
                          assign panel_per_day = 0
                          if panel_days > 0
                            assign panel_per_day = panel_total | divided_by: panel_days
                            assign onetime_per_day = initial_onetime_total | divided_by: panel_days
                          endif
                        -%}
                        <fieldset class="smooch-plans" {{ block.shopify_attributes }}>
                          <legend class="visually-hidden">{{ block.settings.heading | default: 'Choose how to buy' }}</legend>
                          <div class="smooch-subpanel{% unless default_is_subscribe %} smooch-subpanel--inactive{% endunless %}" data-sub-panel>
                            <span class="smooch-subpanel__ribbon smooch-badge smooch-badge--berry" data-sub-ribbon {% unless panel_bundle.settings.most_popular %}hidden{% endunless %}>{{ block.settings.badge | default: 'Most popular' }}</span>
                            <label class="smooch-subpanel__content">
                              {%- comment -%}
                                One fixed cadence only — no frequency picker.
                                The subscription always runs on default_plan
                                (the first real Shopify selling plan). This
                                whole content area is the clickable control
                                that re-selects "subscribe" after one-time
                                has been chosen — there's no separate pill.
                              {%- endcomment -%}
                              {%- if default_plan -%}
                                <input
                                  type="radio"
                                  name="smooch-plan-{{ section.id }}"
                                  value="{{ default_plan.id }}"
                                  {% if default_is_subscribe %}checked{% endif %}
                                  data-smooch-plan-radio
                                  class="visually-hidden"
                                >
                              {%- endif -%}
                              <div class="smooch-subpanel__row">
                                <div class="smooch-subpanel__headline">
                                  <span class="smooch-subpanel__title">{{ block.settings.subscribe_label | default: 'Autoship &' }}</span>
                                  <span class="smooch-subpanel__pct-pill" data-sub-pct-pill {% if panel_pct == 0 %}hidden{% endif %}>
                                    {%- comment -%} &nbsp; survives flex layout's whitespace collapsing. {%- endcomment -%}
                                    Save&nbsp;<span data-sub-pct>{% if panel_pct > 0 %}{{ panel_pct }}{% endif %}</span>%
                                  </span>
                                  {%- if block.settings.promo_pill_text != blank -%}
                                    <span class="smooch-subpanel__promo-pill" data-sub-autobadge {% if panel_pct == 0 %}hidden{% endif %}>
                                      {% render 'smooch-icon', icon: 'tag', class: 'smooch-icon--sm' %}
                                      {{ block.settings.promo_pill_text | escape }}
                                    </span>
                                  {%- endif -%}
                                </div>
                                <p class="smooch-subpanel__price">
                                  <s class="smooch-strike smooch-num" data-sub-compare {% if panel_save <= 0 %}hidden{% endif %}>{{ initial_onetime_total | money }}</s>
                                  <span class="smooch-subpanel__price-current smooch-num" data-sub-price>{{ panel_total | money }}</span>
                                </p>
                              </div>
                              <div class="smooch-subpanel__row">
                                <p class="smooch-subpanel__meta">
                                  <span data-sub-plan-label>{{ panel_bundle.settings.title | default: 'Selected size' }}</span>
                                  <span data-sub-supply>
                                    {%- if default_bundle_qty == 1 %}1 bottle{% else %}{{ default_bundle_qty }} bottles{% endif -%}
                                  </span>
                                  <span data-sub-perday-wrap {% if panel_per_day == 0 %}hidden{% endif %}><span class="smooch-num" data-sub-perday>{% if panel_per_day > 0 %}{{ panel_per_day | money }}{% endif %}</span> / Day</span>
                                </p>
                                <p class="smooch-subpanel__saving smooch-num" data-sub-saving {% if panel_save <= 0 %}hidden{% endif %}>
                                  {%- if panel_save > 0 %}You’re saving {{ panel_save | money }}{% endif -%}
                                </p>
                              </div>
                            </label>

                            <div class="smooch-buybox__buy smooch-subpanel__buy">
                              {%- render 'buy-buttons',
                                block: buy_buttons_block,
                                product: product,
                                product_form_id: product_form_id,
                                section_id: section.id,
                                show_pickup_availability: false
                              -%}
                              {%- if block.settings.benefits != blank -%}
                                {%- assign benefit_lines = block.settings.benefits | newline_to_br | split: '<br />' -%}
                                <ul class="smooch-subpanel__perks smooch-buybox__buy-perks" role="list" data-plan-benefits>
                                  {%- for line in benefit_lines -%}
                                    {%- assign clean_line = line | strip_html | strip -%}
                                    {%- if clean_line != blank -%}
                                      <li>
                                        {% render 'smooch-icon', icon: 'verified', class: 'smooch-icon--sm' %}
                                        <span>{{ clean_line }}</span>
                                      </li>
                                    {%- endif -%}
                                  {%- endfor -%}
                                </ul>
                              {%- endif -%}
                            </div>
                            {%- if section.settings.enable_sticky_atc -%}
                              <div data-smooch-sticky-sentinel data-section-id="{{ section.id }}" aria-hidden="true"></div>
                            {%- endif -%}
                          </div>
                        </fieldset>
                      {%- endif -%}

                    {%- when 'price' -%}
                      <div class="smooch-buybox__price-group{% if offer_ui %} smooch-buybox__price-group--offer{% endif %}" {{ block.shopify_attributes }}>
                        {%- comment -%}
                          Dawn's price node keeps the section-render swap contract alive.
                          It is the visible price for simple setups; in offer mode the
                          computed line below is the visible price and the Dawn node is
                          hidden via the parent modifier class — NOT via class="hidden",
                          because product-info.js removes 'hidden' from this node on
                          every variant change (updateSourceFromDestination).
                        {%- endcomment -%}
                        <div id="price-{{ section.id }}" role="status">
                          {%- render 'price', product: product, use_variant: true, show_badges: false, price_class: 'price--large' -%}
                        </div>
                        {%- if offer_ui -%}
                          {%- liquid
                            assign initial_total = default_unit_price | times: default_bundle_qty
                            assign default_bundle = bundle_blocks[default_bundle_index]
                            assign default_days = default_bundle.settings.days
                          -%}
                          {%- comment -%}
                            One quiet line: the selection recap and its total.
                            The full economics (strike price, save %, per bottle)
                            already live in the supply cards and the subscription
                            panel directly above — repeating them here crowds the
                            path to the add-to-cart button.
                          {%- endcomment -%}
                          <div class="smooch-summary-line" data-smooch-summary>
                            <p class="smooch-summary-line__selection smooch-caption">
                              <span data-summary-supply>
                                {%- if default_bundle_qty == 1 %}1 bottle{% else %}{{ default_bundle_qty }} bottles{% endif -%}
                                {%- if default_days > 0 %} · {{ default_days }}-day supply{% endif -%}
                              </span>
                              <span data-summary-plan {% unless default_is_subscribe %}hidden{% endunless %}>
                                {%- if default_is_subscribe %} · Subscription — {{ default_plan.name | downcase }}{% endif -%}
                              </span>
                            </p>
                            <div class="smooch-offer-price" data-smooch-offer-price role="status">
                              <span class="smooch-offer-price__current smooch-num" data-smooch-price>{{ initial_total | money }}</span>
                            </div>
                          </div>
                        {%- endif -%}
                        {%- if cart.taxes_included or cart.duties_included or shop.shipping_policy.body != blank -%}
                          <div class="smooch-fine-print">
                            {%- if cart.duties_included and cart.taxes_included -%}
                              {{ 'products.product.duties_and_taxes_included' | t }}
                            {%- elsif cart.taxes_included -%}
                              {{ 'products.product.taxes_included' | t }}
                            {%- elsif cart.duties_included -%}
                              {{ 'products.product.duties_included' | t }}
                            {%- endif -%}
                            {%- if shop.shipping_policy.body != blank -%}
                              {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                        <div>
                          {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                          {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                            <input type="hidden" name="id" value="{{ current_variant.id }}">
                            {{ form | payment_terms }}
                          {%- endform -%}
                        </div>
                      </div>

                    {%- when 'buy_buttons' -%}
                      {%- unless has_plans -%}
                        {%- comment -%}
                          Subscription-plan products get their Add to Cart button rendered
                          inside the subscription card itself (see the 'subscription' case
                          above) so the button + micro-trust row sit in the same bordered
                          box as the offer pricing. Products with no selling plans have no
                          such card to live in, so they keep this standalone rendering.
                        {%- endcomment -%}
                        <div class="smooch-buybox__buy" {{ block.shopify_attributes }}>
                          {%- render 'buy-buttons',
                            block: block,
                            product: product,
                            product_form_id: product_form_id,
                            section_id: section.id,
                            show_pickup_availability: false
                          -%}
                        </div>
                        {%- if section.settings.enable_sticky_atc -%}
                          <div data-smooch-sticky-sentinel data-section-id="{{ section.id }}" aria-hidden="true"></div>
                        {%- endif -%}
                      {%- endunless -%}

                      {%- if has_plans -%}
                        <label class="smooch-plan smooch-plan--onetime">
                          <input
                            type="radio"
                            name="smooch-plan-{{ section.id }}"
                            value=""
                            {% unless default_is_subscribe %}checked{% endunless %}
                            data-smooch-plan-radio
                            class="smooch-plan__input visually-hidden"
                          >
                          <span class="smooch-plan__divider-row">
                            <span class="smooch-plan__divider-line" aria-hidden="true"></span>
                            <span class="smooch-plan__divider-text">
                              <span class="smooch-plan__name">{{ subscription_block.settings.onetime_label | default: 'One-Time Purchase' }} -</span>
                              <s class="smooch-strike smooch-num" data-onetime-compare {% unless onetime_compare_total > initial_onetime_total %}hidden{% endunless %}>{{ onetime_compare_total | money }}</s>
                              <span class="smooch-plan__price smooch-num" data-onetime-price>{{ initial_onetime_total | money }}</span>
                              <span class="smooch-plan__perday" data-onetime-perday-wrap {% if onetime_per_day == 0 %}hidden{% endif %}>(<span class="smooch-num" data-onetime-perday>{% if onetime_per_day > 0 %}{{ onetime_per_day | money }}{% endif %}</span> / Day)</span>
                            </span>
                            <span class="smooch-plan__divider-line" aria-hidden="true"></span>
                          </span>
                        </label>

                        {%- if subscription_block.settings.show_discount_badge -%}
                          <p class="smooch-discount-badge" data-discount-badge {% unless default_is_subscribe %}hidden{% endunless %}>
                            {% render 'smooch-icon', icon: 'check', class: 'smooch-icon--sm' %}
                            {{ subscription_block.settings.discount_badge_text | default: 'Discount Auto-Applied' }}
                          </p>
                        {%- endif -%}
                      {%- endif -%}

                    {%- when 'reassurance' -%}
                      {% render 'smooch-purchase-reassurance', block: block, product: product, section_id: section.id %}

                    {%- when 'collapsible_tab' -%}
                      <div class="smooch-accordion smooch-buybox__accordion" {{ block.shopify_attributes }}>
                        <details id="Details-{{ block.id }}-{{ section.id }}" {% if block.settings.open_by_default %}open{% endif %}>
                          <summary aria-controls="Accordion-{{ block.id }}-{{ section.id }}">
                            <span class="smooch-accordion__label">
                              {%- if block.settings.icon != 'none' -%}
                                {% render 'smooch-icon', icon: block.settings.icon %}
                              {%- endif -%}
                              {{ block.settings.heading | default: block.settings.page.title }}
                            </span>
                            {% render 'smooch-icon', icon: 'caret', class: 'smooch-icon--toggle smooch-icon--chevron' %}
                          </summary>
                          <div class="smooch-accordion__content" id="Accordion-{{ block.id }}-{{ section.id }}">
                            {{ block.settings.content }}
                            {{ block.settings.page.content }}
                          </div>
                        </details>
                      </div>

                    {%- when 'text' -%}
                      {%- if block.settings.text != blank -%}
                        <div class="smooch-body rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
                      {%- endif -%}

                    {%- when 'description' -%}
                      {%- if product.description != blank -%}
                        <div class="smooch-body rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
                      {%- endif -%}

                    {%- when 'custom_liquid' -%}
                      {{ block.settings.custom_liquid }}
                  {%- endcase -%}
                {%- endfor -%}

                {%- comment -%} Offer data: real variant / bundle / selling-plan pricing, precomputed in Liquid. {%- endcomment -%}
                {%- if has_bundles or has_plans -%}
                  <script type="application/json" data-smooch-offer>
                    {
                      "sectionId": {{ section.id | json }},
                      "bundles": [
                        {%- for bundle_block in bundle_blocks -%}
                          {%- assign bqty = bundle_block.settings.quantity | at_least: 1 -%}
                          {
                            "quantity": {{ bqty }},
                            "days": {{ bundle_block.settings.days | default: 0 }},
                            "label": {{ bundle_block.settings.title | json }},
                            "variantValue": {{ bundle_block.settings.variant_value | strip | json }},
                            "preselected": {{ bundle_block.settings.preselected | json }},
                            "mostPopular": {{ bundle_block.settings.most_popular | json }},
                            "sellingPlanId": {{ bundle_block.settings.selling_plan_id | append: '' | json }}
                          }{% unless forloop.last %},{% endunless %}
                        {%- endfor -%}
                        {%- if bundle_blocks.size == 0 -%}
                          { "quantity": 1, "days": 0, "label": "", "variantValue": "" }
                        {%- endif -%}
                      ],
                      "plans": [
                        {%- assign plan_index = 0 -%}
                        {%- for group in product.selling_plan_groups -%}
                          {%- for plan in group.selling_plans -%}
                            {%- if plan_index > 0 %},{% endif -%}
                            { "id": {{ plan.id | json }}, "name": {{ plan.name | json }} }
                            {%- assign plan_index = plan_index | plus: 1 -%}
                          {%- endfor -%}
                        {%- endfor -%}
                      ],
                      "variants": {
                        {%- for variant in product.variants -%}
                          "{{ variant.id }}": {
                            "available": {{ variant.available | json }},
                            "options": {{ variant.options | json }},
                            "base": [
                              {%- if bundle_blocks.size > 0 -%}
                                {%- for bundle_block in bundle_blocks -%}
                                  {%- liquid
                                    assign bqty = bundle_block.settings.quantity | at_least: 1
                                    assign bdays = bundle_block.settings.days | default: 0
                                    assign btotal = variant.price | times: bqty
                                    assign bcompare = variant.compare_at_price | default: 0 | times: bqty
                                    assign bsave = 0
                                    assign bsave_amt = 0
                                    if bcompare > btotal
                                      assign bsave_amt = bcompare | minus: btotal
                                      assign bsave_pct = bsave_amt | times: 100
                                      assign bsave = bsave_pct | divided_by: bcompare | round
                                    endif
                                    assign bper_day = 0
                                    if bdays > 0
                                      assign bper_day = btotal | divided_by: bdays
                                    endif
                                  -%}
                                  {
                                    "t": {{ btotal | money | json }},
                                    "c": {% if bcompare > btotal %}{{ bcompare | money | json }}{% else %}""{% endif %},
                                    "u": {{ variant.price | money | json }},
                                    "s": {{ bsave }},
                                    "sa": {% if bsave_amt > 0 %}{{ bsave_amt | money | json }}{% else %}""{% endif %},
                                    "pd": {% if bper_day > 0 %}{{ bper_day | money | json }}{% else %}""{% endif %}
                                  }{% unless forloop.last %},{% endunless %}
                                {%- endfor -%}
                              {%- else -%}
                                {%- assign btotal = variant.price -%}
                                {%- assign bcompare = variant.compare_at_price | default: 0 -%}
                                {
                                  "t": {{ btotal | money | json }},
                                  "c": {% if bcompare > btotal %}{{ bcompare | money | json }}{% else %}""{% endif %},
                                  "u": {{ variant.price | money | json }},
                                  "s": 0,
                                  "sa": {% if bcompare > btotal %}{{ bcompare | minus: btotal | money | json }}{% else %}""{% endif %},
                                  "pd": ""
                                }
                              {%- endif -%}
                            ],
                            "plans": {
                              {%- for allocation in variant.selling_plan_allocations -%}
                                "{{ allocation.selling_plan.id }}": [
                                  {%- if bundle_blocks.size > 0 -%}
                                    {%- for bundle_block in bundle_blocks -%}
                                      {%- liquid
                                        assign bqty = bundle_block.settings.quantity | at_least: 1
                                        assign bdays = bundle_block.settings.days | default: 0
                                        assign ptotal = allocation.price | times: bqty
                                        assign pcompare_base = allocation.compare_at_price | default: variant.price
                                        assign pcompare = pcompare_base | times: bqty
                                        assign psave = 0
                                        assign psave_amt = 0
                                        if pcompare > ptotal
                                          assign psave_amt = pcompare | minus: ptotal
                                          assign psave_pct = psave_amt | times: 100
                                          assign psave = psave_pct | divided_by: pcompare | round
                                        endif
                                        assign pper_day = 0
                                        if bdays > 0
                                          assign pper_day = ptotal | divided_by: bdays
                                        endif
                                      -%}
                                      {
                                        "t": {{ ptotal | money | json }},
                                        "c": {% if pcompare > ptotal %}{{ pcompare | money | json }}{% else %}""{% endif %},
                                        "u": {{ allocation.price | money | json }},
                                        "s": {{ psave }},
                                        "sa": {% if psave_amt > 0 %}{{ psave_amt | money | json }}{% else %}""{% endif %},
                                        "pd": {% if pper_day > 0 %}{{ pper_day | money | json }}{% else %}""{% endif %}
                                      }{% unless forloop.last %},{% endunless %}
                                    {%- endfor -%}
                                  {%- else -%}
                                    {%- assign ptotal = allocation.price -%}
                                    {%- assign pcompare = allocation.compare_at_price | default: variant.price -%}
                                    {%- assign psave = 0 -%}
                                    {%- assign psave_amt = 0 -%}
                                    {%- if pcompare > ptotal -%}
                                      {%- assign psave_amt = pcompare | minus: ptotal -%}
                                      {%- assign psave_pct = psave_amt | times: 100 -%}
                                      {%- assign psave = psave_pct | divided_by: pcompare | round -%}
                                    {%- endif -%}
                                    {
                                      "t": {{ ptotal | money | json }},
                                      "c": {% if pcompare > ptotal %}{{ pcompare | money | json }}{% else %}""{% endif %},
                                      "u": {{ allocation.price | money | json }},
                                      "s": {{ psave }},
                                      "sa": {% if psave_amt > 0 %}{{ psave_amt | money | json }}{% else %}""{% endif %},
                                      "pd": ""
                                    }
                                  {%- endif -%}
                                ]{% unless forloop.last %},{% endunless %}
                              {%- endfor -%}
                            }
                          }{% unless forloop.last %},{% endunless %}
                        {%- endfor -%}
                      }
                    }
                  </script>
                {%- endif -%}
              </smooch-offer>
            </section>
          </div>
        </div>
      </div>

      {%- if section.settings.enable_sticky_atc -%}
        {%- liquid
          assign sticky_bundle = bundle_blocks[default_bundle_index]
          assign sticky_days = sticky_bundle.settings.days | default: 0
          assign sticky_qty = default_bundle_qty
          assign sticky_total = default_unit_price | times: sticky_qty

          assign sticky_compare_unit = 0
          if default_is_subscribe and default_plan
            assign sticky_compare_unit = current_variant.price
            for alloc in current_variant.selling_plan_allocations
              if alloc.selling_plan.id == default_plan.id
                assign sticky_compare_unit = alloc.compare_at_price | default: current_variant.price
              endif
            endfor
          else
            assign sticky_compare_unit = current_variant.compare_at_price | default: 0
          endif
          assign sticky_compare_total = sticky_compare_unit | times: sticky_qty

          assign sticky_save_amt = 0
          assign sticky_save_pct = 0
          if sticky_compare_total > sticky_total
            assign sticky_save_amt = sticky_compare_total | minus: sticky_total
            assign sticky_save_pct_amt = sticky_save_amt | times: 100
            assign sticky_save_pct = sticky_save_pct_amt | divided_by: sticky_compare_total | round
          endif

          assign sticky_per_day = 0
          if sticky_days > 0
            assign sticky_per_day = sticky_total | divided_by: sticky_days
          endif
        -%}
        <smooch-sticky-atc
          class="smooch-sticky-atc"
          data-section-id="{{ section.id }}"
          hidden
        >
          <div class="smooch-sticky-atc__inner">
            {%- if section.settings.sticky_atc_show_thumbnail and product.featured_media -%}
              <div class="smooch-sticky-atc__thumb">
                {{ product.featured_media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', sizes: '5rem', alt: '' }}
              </div>
            {%- endif -%}

            <div class="smooch-sticky-atc__info">
              {%- if section.settings.sticky_atc_show_rating and rating_block -%}
                <div class="smooch-sticky-atc__rating">
                  {% render 'smooch-rating',
                    product: product,
                    fallback_rating: rating_block.settings.fallback_rating,
                    fallback_count: rating_block.settings.fallback_count,
                    show_sample_label: false,
                    link: true
                  %}
                </div>
              {%- endif -%}
              <span class="smooch-sticky-atc__title" data-sticky-summary>
                {{- display_title | escape -}}
              </span>
            </div>

            {%- if section.settings.sticky_atc_show_savings -%}
              <span class="smooch-sticky-atc__save" data-sticky-save {% unless sticky_save_pct > 0 %}hidden{% endunless %}>
                {%- if sticky_save_pct > 0 %}Subscribe & Save {{ sticky_save_pct }}%{% endif -%}
              </span>
            {%- endif -%}
            <span class="smooch-sticky-atc__price-wrap">
              <s class="smooch-sticky-atc__compare smooch-num" data-sticky-compare {% unless sticky_compare_total > sticky_total %}hidden{% endunless %}>
                {{- sticky_compare_total | money -}}
              </s>
              <span class="smooch-sticky-atc__price smooch-num" data-sticky-price>{{- sticky_total | money -}}</span>
              {%- if section.settings.sticky_atc_show_per_day -%}
                <span class="smooch-sticky-atc__perday" data-sticky-perday-wrap {% if sticky_per_day == 0 %}hidden{% endif %}>
                  <span class="smooch-num" data-sticky-perday>{% if sticky_per_day > 0 %}{{ sticky_per_day | money }}{% endif %}</span> / day
                </span>
              {%- endif -%}
            </span>

            <button type="button" class="smooch-btn smooch-btn--berry smooch-sticky-atc__button" data-sticky-submit>
              <span data-sticky-label>{% if section.settings.sticky_atc_cta_text != blank %}{{ section.settings.sticky_atc_cta_text | escape }}{% else %}{{ 'products.product.add_to_cart' | t }}{% endif %}</span>
              {%- render 'loading-spinner' -%}
            </button>
          </div>
        </smooch-sticky-atc>
      {%- endif -%}

      {%- if product.media.size > 0 -%}
        {% render 'product-media-modal', variant_images: variant_images %}
        <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
        <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
      {%- endif -%}
    </product-component>

    {%- if first_3d_model -%}
      <script type="application/json" id="ProductJSON-{{ section.id }}">
        {{ product.media | where: 'media_type', 'model' | json }}
      </script>
      <script src="{{ 'product-model.js' | asset_url }}" defer></script>
    {%- endif -%}
  {%- else -%}
    <div class="page-width">
      <div class="grid grid--1-col grid--2-col-tablet smooch-product__layout">
        <div class="grid__item smooch-product__gallery">
          <div class="smooch-media smooch-media--square" style="background: var(--smooch-blush); display: grid; place-items: center;">
            {{ 'product-1' | placeholder_svg_tag: 'smooch-product__placeholder-svg' }}
          </div>
        </div>
        <div class="grid__item smooch-product__panel">
          <section class="smooch-buybox">
            <p class="smooch-eyebrow smooch-eyebrow--accent">{{ brand_name }}</p>
            <h1 class="smooch-h2">Example product title</h1>
            <p class="smooch-lead">Select a product for this section in the theme editor to activate the purchase module.</p>
          </section>
        </div>
      </div>
    </div>
  {%- endif -%}
</product-info>

{% schema %}
{
  "name": "Smooch product hero",
  "tag": "section",
  "class": "section smooch-product-hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "The primary purchase module: gallery, bundle selector, subscription options, and add to cart. Designed for the main product template."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "Sticky purchase panel on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_atc",
      "label": "Sticky add-to-cart bar",
      "info": "Shows once the visitor scrolls past the main purchase controls.",
      "default": true
    },
    {
      "type": "text",
      "id": "sticky_atc_cta_text",
      "label": "Sticky bar button text",
      "info": "Leave blank to match the main Add to cart button.",
      "default": "Add to Cart"
    },
    {
      "type": "checkbox",
      "id": "sticky_atc_show_rating",
      "label": "Sticky bar: show review rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_atc_show_savings",
      "label": "Sticky bar: show subscribe & save badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_atc_show_per_day",
      "label": "Sticky bar: show per-day price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_atc_show_thumbnail",
      "label": "Sticky bar: show product thumbnail (desktop)",
      "default": true
    },
    {
      "type": "header",
      "content": "Media gallery"
    },
    {
      "type": "paragraph",
      "content": "The gallery is a full-width swipe/drag carousel: the first image reads as a hero composition sitting directly on the page, with no box around it."
    },
    {
      "type": "checkbox",
      "id": "use_media_background",
      "label": "Use a custom canvas background",
      "default": false,
      "info": "Off: the media area is transparent and the section background shows through (best for cutout/transparent imagery). On: the canvas uses the color below — match it to the background baked into your photos so the image blends seamlessly into the page."
    },
    {
      "type": "color",
      "id": "media_background",
      "label": "Canvas background color",
      "default": "#FAF1EE"
    },
    {
      "type": "checkbox",
      "id": "show_gallery_arrows",
      "label": "Show gallery arrows",
      "default": true,
      "info": "Subtle previous/next controls that appear on hover (desktop only — mobile navigates by swiping)."
    },
    {
      "type": "checkbox",
      "id": "show_gallery_dots",
      "label": "Show gallery dots",
      "default": true
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "options": [
        { "value": "stacked", "label": "t:sections.main-product.settings.gallery_layout.options__1.label" },
        { "value": "columns", "label": "t:sections.main-product.settings.gallery_layout.options__2.label" },
        { "value": "thumbnail", "label": "t:sections.main-product.settings.gallery_layout.options__3.label" },
        { "value": "thumbnail_slider", "label": "t:sections.main-product.settings.gallery_layout.options__4.label" }
      ],
      "default": "columns",
      "label": "t:sections.main-product.settings.gallery_layout.label"
    },
    {
      "type": "select",
      "id": "media_size",
      "options": [
        { "value": "small", "label": "t:sections.main-product.settings.media_size.options__1.label" },
        { "value": "medium", "label": "t:sections.main-product.settings.media_size.options__2.label" },
        { "value": "large", "label": "t:sections.main-product.settings.media_size.options__3.label" }
      ],
