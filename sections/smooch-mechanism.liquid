{{ 'section-smooch-mechanism.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign brand_name = settings.smooch_brand_name | default: shop.name
  assign pillar_blocks = section.blocks | where: 'type', 'pillar'

  assign image_alt = section.settings.product_image_alt
  if image_alt == blank
    assign image_alt = section.settings.product_image.alt
  endif
  if image_alt == blank
    assign image_alt = brand_name | append: ' product'
  endif
-%}

<div class="smooch-band smooch-mechanism color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.lead != blank
    -%}
      <div class="smooch-section-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="smooch-eyebrow smooch-eyebrow--accent">
            {{- section.settings.eyebrow | replace: '[brand]', brand_name | escape -}}
          </p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="smooch-{{ section.settings.heading_size }}">
            {{- section.settings.heading | replace: '[brand]', brand_name | escape -}}
          </h2>
        {%- endif -%}
        {%- if section.settings.lead != blank -%}
          <p class="smooch-lead">
            {{- section.settings.lead | replace: '[brand]', brand_name | escape -}}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="smooch-benefits">
      <div class="smooch-benefits__visual">
        <div class="smooch-benefits__frame">
          {%- if section.settings.product_image != blank -%}
            {{
              section.settings.product_image
              | image_url: width: 700
              | image_tag:
                loading: 'lazy',
                widths: '280, 420, 560, 700',
                sizes: '(min-width: 990px) 34vw, 60vw',
                class: 'smooch-benefits__visual-img',
                alt: image_alt
            }}
          {%- else -%}
            {%- comment -%}
              Bundled real product photo used until a merchant picks one —
              see the paragraph note in this section's schema.
            {%- endcomment -%}
            <img
              src="{{ 'smooch-demo-bottle-open.png' | asset_url }}"
              width="1086"
              height="1448"
              loading="lazy"
              class="smooch-benefits__visual-img"
              alt="{{ image_alt | escape }}"
            >
          {%- endif -%}
        </div>
        {%- if section.settings.product_caption != blank -%}
          <p class="smooch-caption smooch-benefits__caption">
            {{- section.settings.product_caption | replace: '[brand]', brand_name | escape -}}
          </p>
        {%- endif -%}
      </div>

      {%- if pillar_blocks.size > 0 -%}
        <ul class="smooch-benefits__list" role="list">
          {%- for block in pillar_blocks -%}
            <li class="smooch-benefits__card" {{ block.shopify_attributes }}>
              <span class="smooch-benefits__icon">
                {%- render 'smooch-icon', icon: block.settings.icon, class: 'smooch-icon--lg' -%}
              </span>
              {%- if block.settings.title != blank -%}
                <p class="smooch-benefits__label">
                  {{- block.settings.title | replace: '[brand]', brand_name | escape -}}
                </p>
              {%- endif -%}
              <div class="smooch-benefits__body">
                {%- if block.settings.text != blank -%}
                  <p class="smooch-benefits__text">
                    {{- block.settings.text | replace: '[brand]', brand_name | escape -}}
                  </p>
                {%- endif -%}
                {%- if block.settings.ingredient != blank -%}
                  <p class="smooch-benefits__callout">
                    {{- block.settings.ingredient | escape -}}
                  </p>
                {%- endif -%}
                <span class="smooch-benefits__dot" aria-hidden="true"></span>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="smooch-fine-print smooch-mechanism__footnote">
        {{- section.settings.footnote | escape -}}
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Smooch mechanism",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "A simple benefits row: one card per pillar (icon, black label, short description), with your product photo alongside. Keep each card to one clear benefit — this is meant to be scanned in a few seconds, not read like a diagram."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A simple system of support.",
      "info": "Use [brand] to insert the brand name."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Standard" },
        { "value": "display", "label": "Oversized" }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead paragraph",
      "default": "One gummy, most mornings. [brand] is formulated to layer small, steady support behind the way you feel — gently, and on your timeline. Experiences vary from woman to woman.",
      "info": "Use [brand] to insert the brand name."
    },
    {
      "type": "header",
      "content": "Product image"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image",
      "info": "Shown beside the benefit cards. Leave blank to hide it and let the cards run full width."
    },
    {
      "type": "text",
      "id": "product_image_alt",
      "label": "Image alt text",
      "info": "Describes the image for screen readers. Leave blank to use the image's own alt text."
    },
    {
      "type": "text",
      "id": "product_caption",
      "label": "Caption under the product",
      "default": "One daily gummy"
    },
    {
      "type": "header",
      "content": "Footnote"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "*Add your key ingredient once your formula is final.",
      "info": "Pairs with the * in pillar ingredient callouts. Clear this field to hide it."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Benefit card",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "heart", "label": "Heart" },
            { "value": "moon", "label": "Moon" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "drop", "label": "Drop" },
            { "value": "star", "label": "Star" }
          ],
          "default": "sparkle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Mood"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Formulated with ingredients traditionally used to support a steadier, calmer baseline.",
          "info": "Keep it to one or two sentences."
        },
        {
          "type": "text",
          "id": "ingredient",
          "label": "Ingredient callout",
          "info": "Optional. Example: \"with Maca root*\" — the * pairs with the section footnote."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smooch mechanism",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "icon": "sparkle",
            "title": "Calm the noise",
            "text": "Formulated to support a more settled everyday mindset."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "heart",
            "title": "Support your spark",
            "text": "Support for desire, energy, and openness — gently, over time."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "moon",
            "title": "Make connection feel easier",
            "text": "Support for feeling present, open, and connected."
          }
        }
      ]
    }
  ]
}
{% endschema %}
