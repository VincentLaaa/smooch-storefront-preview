{{ 'section-smooch-press-bar.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign outlets = section.blocks | where: 'type', 'outlet'
  assign has_outlets = false
  for block in outlets
    if block.settings.name != blank or block.settings.logo != blank
      assign has_outlets = true
    endif
  endfor
-%}

{%- if has_outlets -%}
  <div class="smooch-band smooch-press-bar__band color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="smooch-press-bar">
        {%- if section.settings.heading != blank -%}
          <h2 class="smooch-press-bar__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        <ul class="smooch-press-bar__list" role="list">
          {%- for block in outlets -%}
            {%- if block.settings.name != blank or block.settings.logo != blank -%}
              <li class="smooch-press-bar__item" {{ block.shopify_attributes }}>
                {%- capture outlet_mark -%}
                  {%- if block.settings.logo != blank -%}
                    {{ block.settings.logo | image_url: width: 320 | image_tag: loading: 'lazy', widths: '160, 320', sizes: '16rem', class: 'smooch-press-bar__logo', alt: block.settings.name | default: block.settings.logo.alt }}
                  {%- else -%}
                    <span class="smooch-press-bar__wordmark smooch-press-bar__wordmark--{{ block.settings.style }}">
                      {{- block.settings.name -}}
                    </span>
                  {%- endif -%}
                {%- endcapture -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="smooch-press-bar__link smooch-focus" target="_blank" rel="noopener">
                    {{ outlet_mark }}
                    <span class="visually-hidden">{{ block.settings.name | escape }} ({{ 'accessibility.link_messages.new_window' | t }})</span>
                  </a>
                {%- else -%}
                  {{ outlet_mark }}
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width" style="padding: 2rem 0;">
    <p class="smooch-caption">Press bar: add outlet blocks to display it. Only list outlets that have genuinely featured your brand.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Smooch press bar",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Only list outlets that have genuinely featured your brand — press mentions you can't substantiate are an advertising-compliance risk. Wordmarks render as styled text; upload official logo files only if you have permission to use them."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As featured in"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "outlet",
      "name": "Outlet",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Outlet name"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Wordmark style",
          "default": "serif-caps",
          "options": [
            { "value": "serif-caps", "label": "Serif caps" },
            { "value": "serif", "label": "Serif" },
            { "value": "sans-caps", "label": "Sans caps" },
            { "value": "sans-lower", "label": "Sans lowercase" }
          ]
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Official logo (optional)",
          "info": "Overrides the text wordmark. Only use artwork you're licensed to use."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link to the feature (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smooch press bar",
      "blocks": [
        { "type": "outlet", "settings": { "name": "Marie Claire", "style": "serif-caps" } },
        { "type": "outlet", "settings": { "name": "goop", "style": "sans-lower" } },
        { "type": "outlet", "settings": { "name": "VOGUE", "style": "serif-caps" } },
        { "type": "outlet", "settings": { "name": "COSMOPOLITAN", "style": "sans-caps" } }
      ]
    }
  ]
}
{% endschema %}
