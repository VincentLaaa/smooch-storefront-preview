{{ 'section-smooch-stats.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.7 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #StatsCard-{{ section.id }} {
    background: linear-gradient(
      105deg,
      {{ section.settings.gradient_start }} 0%,
      {{ section.settings.gradient_end }} 100%
    );
  }
{%- endstyle -%}

{%- liquid
  assign brand_name = settings.smooch_brand_name | default: shop.name
  assign stat_blocks = section.blocks | where: 'type', 'stat'
-%}

<div class="smooch-band smooch-stats color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="smooch-stats__card" id="StatsCard-{{ section.id }}">
      <div class="smooch-stats__content">
        <h2 class="smooch-stats__heading">
          {%- if section.settings.heading_line1 != blank -%}
            <span class="smooch-stats__heading-bold">{{ section.settings.heading_line1 | replace: '[brand]', brand_name | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading_line2 != blank -%}
            <span class="smooch-stats__heading-accent">{{ section.settings.heading_line2 | replace: '[brand]', brand_name | escape }}</span>
          {%- endif -%}
        </h2>
        {%- if section.settings.subline != blank -%}
          <p class="smooch-stats__subline">{{ section.settings.subline | replace: '[brand]', brand_name | escape }}</p>
        {%- endif -%}

        {%- if stat_blocks.size > 0 -%}
          <ul class="smooch-stats__list" role="list">
            {%- for block in stat_blocks -%}
              <li class="smooch-stats__stat" {{ block.shopify_attributes }}>
                <span class="smooch-stats__value smooch-num">{{ block.settings.value | escape }}</span>
                <span class="smooch-stats__label">{{ block.settings.label | replace: '[brand]', brand_name | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="smooch-stats__visual" aria-hidden="true">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '450, 700, 900',
              sizes: '(min-width: 990px) 44vw, 90vw',
              class: 'smooch-stats__img',
              alt: ''
          }}
        {%- else -%}
          {%- comment -%}
            Bundled AI product visual used until the merchant uploads their
            own — same fallback pattern as the other bundled visuals.
          {%- endcomment -%}
          <img
            src="{{ 'smooch-stats-gummies.jpg' | asset_url }}"
            width="900"
            height="900"
            loading="lazy"
            class="smooch-stats__img"
            alt=""
          >
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="smooch-fine-print smooch-stats__footnote">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Smooch stats",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "\"Backed by user data\" panel: gradient card with a two-line headline, stacked oversized stats, and a product visual. Any percentage or multiplier shown here must be substantiated before paid traffic."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1 (bold)",
      "default": "What Women"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2 (italic accent)",
      "default": "Actually Notice"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Subline",
      "default": "Real answers from women who made [brand] a daily ritual."
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Gradient start",
      "default": "#6E1B34"
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "Gradient end",
      "default": "#F65275"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Visual",
      "info": "Shown on the right of the card. Leave blank to use the bundled gummies visual."
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "info": "Fine print under the card, e.g. the survey source for the stats."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "100k+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Happy customers worldwide." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smooch stats",
      "blocks": [
        { "type": "stat", "settings": { "value": "100k+", "label": "Happy customers worldwide." } },
        { "type": "stat", "settings": { "value": "82%", "label": "Say they feel more like themselves again" } },
        { "type": "stat", "settings": { "value": "3x", "label": "More nights that end closer, not just tired" } }
      ]
    }
  ]
}
{% endschema %}
