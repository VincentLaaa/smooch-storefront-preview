{% comment %}
  Emits Smooch brand design tokens from global theme settings and loads the
  shared Smooch stylesheets and script. Rendered once from layout/theme.liquid,
  directly after base.css so tokens can rely on Dawn's :root variables.

  All color tokens are emitted both as bare RGB triplets (--smooch-*-rgb, for
  rgba() composition, matching Dawn's convention) and as ready-to-use colors.
{% endcomment %}

{% style %}
  :root {
    --smooch-cream-rgb: {{ settings.smooch_color_cream.red }}, {{ settings.smooch_color_cream.green }}, {{ settings.smooch_color_cream.blue }};
    --smooch-surface-rgb: {{ settings.smooch_color_surface.red }}, {{ settings.smooch_color_surface.green }}, {{ settings.smooch_color_surface.blue }};
    --smooch-ink-rgb: {{ settings.smooch_color_ink.red }}, {{ settings.smooch_color_ink.green }}, {{ settings.smooch_color_ink.blue }};
    --smooch-muted-rgb: {{ settings.smooch_color_muted.red }}, {{ settings.smooch_color_muted.green }}, {{ settings.smooch_color_muted.blue }};
    --smooch-berry-rgb: {{ settings.smooch_color_berry.red }}, {{ settings.smooch_color_berry.green }}, {{ settings.smooch_color_berry.blue }};
    --smooch-blush-rgb: {{ settings.smooch_color_blush.red }}, {{ settings.smooch_color_blush.green }}, {{ settings.smooch_color_blush.blue }};
    --smooch-plum-rgb: {{ settings.smooch_color_plum.red }}, {{ settings.smooch_color_plum.green }}, {{ settings.smooch_color_plum.blue }};
    --smooch-pink-rgb: {{ settings.smooch_color_pink.red }}, {{ settings.smooch_color_pink.green }}, {{ settings.smooch_color_pink.blue }};
    --smooch-lilac-rgb: {{ settings.smooch_color_lilac.red }}, {{ settings.smooch_color_lilac.green }}, {{ settings.smooch_color_lilac.blue }};
    --smooch-cta-bg-rgb: {{ settings.smooch_cta_bg.red }}, {{ settings.smooch_cta_bg.green }}, {{ settings.smooch_cta_bg.blue }};
    --smooch-cta-text-rgb: {{ settings.smooch_cta_text.red }}, {{ settings.smooch_cta_text.green }}, {{ settings.smooch_cta_text.blue }};

    --smooch-cream: rgb(var(--smooch-cream-rgb));
    --smooch-surface: rgb(var(--smooch-surface-rgb));
    --smooch-ink: rgb(var(--smooch-ink-rgb));
    --smooch-muted: rgb(var(--smooch-muted-rgb));
    --smooch-berry: rgb(var(--smooch-berry-rgb));
    --smooch-blush: rgb(var(--smooch-blush-rgb));
    --smooch-plum: rgb(var(--smooch-plum-rgb));
    --smooch-pink: rgb(var(--smooch-pink-rgb));
    --smooch-lilac: rgb(var(--smooch-lilac-rgb));
    --smooch-cta-bg: rgb(var(--smooch-cta-bg-rgb));
    --smooch-cta-text: rgb(var(--smooch-cta-text-rgb));

    --smooch-border-soft: rgba(var(--color-foreground), 0.12);
    --smooch-border-strong: rgba(var(--color-foreground), 0.3);
    --smooch-radius-button: var(--buttons-radius, 8px);
    --smooch-radius-card: var(--text-boxes-radius, 16px);
    --smooch-radius-media: var(--media-radius, 12px);
  }
{% endstyle %}

{%- if settings.favicon == blank -%}
  {%- comment -%} Brand "oo" submark favicon until a merchant favicon is uploaded. {%- endcomment -%}
  <link rel="icon" type="image/svg+xml" href="{{ 'smooch-favicon.svg' | asset_url }}">
{%- endif -%}

{{ 'smooch-base.css' | asset_url | stylesheet_tag }}
{{ 'smooch-layout.css' | asset_url | stylesheet_tag }}
{{ 'smooch-components.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Loads last so its overrides (Fraunces heading pass-through, Loretta,
  Euclid Flex) actually win — smooch-base.css sets its OWN fallback
  defaults for these same custom properties (e.g. --smooch-font-label),
  and a :root rule loaded earlier loses a same-specificity tie to one
  loaded later regardless of which file "sounds like" the override.
{%- endcomment -%}
{%- if settings.smooch_use_brand_fonts -%}
  {{ 'smooch-fonts.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<script src="{{ 'smooch.js' | asset_url }}" defer="defer"></script>
