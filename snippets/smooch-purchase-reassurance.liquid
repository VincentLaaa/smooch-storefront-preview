{% comment %}
  Renders the compact reassurance area under the add-to-cart button.
  Copy comes from Theme settings → Smooch brand; the block toggles rows.
  The low-inventory note reads real Shopify inventory only and keeps
  Dawn's Inventory-{section id} swap contract so it updates on variant change.

  Accepts:
  - block: {Object} 'reassurance' block
  - product: {Object}
  - section_id: {String}

  Usage:
  {% render 'smooch-purchase-reassurance', block: block, product: product, section_id: section.id %}
{% endcomment %}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign show_low_stock = false
  if block.settings.show_inventory and variant.inventory_management == 'shopify' and variant.inventory_policy != 'continue' and variant.inventory_quantity > 0 and variant.inventory_quantity <= block.settings.inventory_threshold
    assign show_low_stock = true
  endif
-%}

<div class="smooch-reassurance" {{ block.shopify_attributes }}>
  {%- if block.settings.show_inventory -%}
    <p
      id="Inventory-{{ section_id }}"
      class="smooch-reassurance__stock{% unless show_low_stock %} hidden{% endunless %}"
      role="status"
    >
      {%- if show_low_stock -%}
        Only {{ variant.inventory_quantity }} left in stock
      {%- endif -%}
    </p>
  {%- endif -%}

  {%- if block.settings.style == 'grid' -%}
    {%- comment -%}
      Figma shipping timeline (replaces the old 3-tile trust grid):
      order -> ships -> delivered icons joined by a line, with an
      "Order within N hrs" countdown pill (to local end of day) and a
      delivery date two days out. Both figures are filled and kept
      fresh client-side.
    {%- endcomment -%}
    <div class="smooch-ship-timeline" id="ShipTimeline-{{ section_id }}">
      <div class="smooch-ship-timeline__track" aria-hidden="true">
        {% render 'smooch-icon', icon: 'cart-solid', class: 'smooch-ship-timeline__icon' %}
        {% render 'smooch-icon', icon: 'truck-solid', class: 'smooch-ship-timeline__icon' %}
        {% render 'smooch-icon', icon: 'check-circle-solid', class: 'smooch-ship-timeline__icon' %}
      </div>
      <div class="smooch-ship-timeline__labels">
        <span class="smooch-ship-timeline__label">
          Order within
          <span class="smooch-ship-timeline__pill smooch-num" data-ship-countdown>today</span>
        </span>
        <span class="smooch-ship-timeline__label">Ships Same Day From&nbsp;Utah</span>
        <span class="smooch-ship-timeline__label">
          Delivered by
          <span class="smooch-num" data-ship-delivery-date></span>
        </span>
      </div>
    </div>
    <script>
      (function () {
        var root = document.getElementById('ShipTimeline-{{ section_id }}');
        if (!root || root.dataset.shipInit) return;
        root.dataset.shipInit = '1';
        var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        function ordinal(n) {
          if (n % 100 >= 11 && n % 100 <= 13) return 'th';
          return { 1: 'st', 2: 'nd', 3: 'rd' }[n % 10] || 'th';
        }
        function tick() {
          var now = new Date();
          var end = new Date(now);
          end.setHours(24, 0, 0, 0);
          var hrs = Math.max(1, Math.ceil((end - now) / 3600000));
          var cd = root.querySelector('[data-ship-countdown]');
          if (cd) cd.textContent = hrs + (hrs === 1 ? ' hr' : ' hrs');
          var d = new Date(now);
          d.setDate(d.getDate() + 2);
          var del = root.querySelector('[data-ship-delivery-date]');
          if (del) del.textContent = MONTHS[d.getMonth()] + ' ' + d.getDate() + ordinal(d.getDate());
        }
        tick();
        setInterval(tick, 60000);
      })();
    </script>
  {%- else -%}
    <ul class="smooch-reassurance__list{% if block.settings.style == 'badges' %} smooch-reassurance__list--badges{% endif %}" role="list">
      {%- if block.settings.show_delivery and settings.smooch_delivery_estimate != blank -%}
        <li>
          {% if block.settings.style == 'badges' %}{% render 'smooch-icon', icon: 'check', class: 'smooch-icon--sm' %}{% else %}{% render 'smooch-icon', icon: 'truck' %}{% endif %}
          <span>{{ settings.smooch_delivery_estimate }}</span>
        </li>
      {%- endif -%}
      {%- if block.settings.show_shipping and settings.smooch_shipping_message != blank -%}
        <li>
          {% if block.settings.style == 'badges' %}{% render 'smooch-icon', icon: 'check', class: 'smooch-icon--sm' %}{% else %}{% render 'smooch-icon', icon: 'box' %}{% endif %}
          <span>{{ settings.smooch_shipping_message }}</span>
        </li>
      {%- endif -%}
      {%- if block.settings.show_guarantee and settings.smooch_guarantee_days > 0 -%}
        <li>
          {% if block.settings.style == 'badges' %}{% render 'smooch-icon', icon: 'check', class: 'smooch-icon--sm' %}{% else %}{% render 'smooch-icon', icon: 'shield' %}{% endif %}
          <span>{{ settings.smooch_guarantee_days }}-day {{ settings.smooch_guarantee_text | default: 'money-back guarantee' }}</span>
        </li>
      {%- endif -%}
      {%- if block.settings.show_secure and settings.smooch_secure_checkout_text != blank -%}
        <li>
          {% if block.settings.style == 'badges' %}{% render 'smooch-icon', icon: 'check', class: 'smooch-icon--sm' %}{% else %}{% render 'smooch-icon', icon: 'lock' %}{% endif %}
          <span>{{ settings.smooch_secure_checkout_text }}</span>
        </li>
      {%- endif -%}
    </ul>
  {%- endif -%}

  {%- if settings.smooch_show_payment_icons and shop.enabled_payment_types.size > 0 -%}
    <div class="smooch-reassurance__payments">
      <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
      <ul class="smooch-reassurance__payment-list" role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- if block.settings.footer_text != blank -%}
    <p class="smooch-reassurance__footer-row">
      {% render 'smooch-icon', icon: 'info', class: 'smooch-icon--sm' %}
      <span>{{ block.settings.footer_text | escape }}</span>
      {%- if block.settings.footer_link_text != blank and block.settings.footer_link_url != blank -%}
        <a href="{{ block.settings.footer_link_url }}" class="smooch-reassurance__footer-link">{{ block.settings.footer_link_text | escape }}</a>
      {%- endif -%}
    </p>
  {%- endif -%}
</div>
