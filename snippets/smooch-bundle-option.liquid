{% comment %}
  Renders one supply option card (radio + label) in the guided purchase flow.

  Deliberately minimal: month label, gummy count (one gummy/day, so count ==
  days of supply), and the per-day price estimate — no price/compare/savings
  on the card itself (that full breakdown already lives in the subscription
  card below). All figures are real: variant price × quantity, server-
  rendered for the initially selected variant with no selling plan.
  smooch-product-form.js re-renders the per-day figure from the offer-data
  JSON when variant, bundle, or selling plan changes.

  Accepts:
  - block: {Object} 'bundle' block
  - index: {Number} 0-based bundle index
  - section_id: {String}
  - product: {Object}
  - current_variant: {Object}
  - checked_index: {Number} initially selected bundle index

  Usage:
  {% render 'smooch-bundle-option', block: block, index: 0, section_id: section.id, product: product, current_variant: current_variant, checked_index: 0 %}
{% endcomment %}

{%- liquid
  assign qty = block.settings.quantity | at_least: 1
  assign days = block.settings.days
  assign total = current_variant.price | times: qty
  assign per_day = 0
  if days > 0
    assign per_day = total | divided_by: days
  endif

  comment
    Server-rendered sold-out state for quantity-mode bundles (they sell the
    currently selected variant). Variant-mode targets are resolved in JS.
  endcomment
  assign initially_unavailable = false
  if current_variant.available == false and block.settings.variant_value == blank
    assign initially_unavailable = true
  endif
-%}

<label class="smooch-bundle{% if initially_unavailable %} smooch-bundle--soldout{% endif %}" {{ block.shopify_attributes }}>
  <input
    type="radio"
    class="visually-hidden smooch-bundle__input"
    name="smooch-bundle-{{ section_id }}"
    value="{{ index }}"
    data-smooch-bundle-radio
    data-quantity="{{ qty }}"
    data-days="{{ days | default: '' }}"
    data-label="{{ block.settings.title | escape }}"
    data-variant-value="{{ block.settings.variant_value | strip | escape }}"
    {% if index == checked_index %}checked{% endif %}
  >
  <span class="smooch-bundle__card">
    {%- if block.settings.badge != blank -%}
      <span class="smooch-bundle__badge smooch-badge smooch-badge--berry">{{ block.settings.badge }}</span>
    {%- endif -%}
    <span class="smooch-bundle__check" aria-hidden="true">
      {% render 'smooch-icon', icon: 'check', class: 'smooch-icon--sm' %}
    </span>
    {%- if block.settings.show_thumbnail -%}
      {%- if qty >= 1 and qty <= 3 -%}
        {%- comment -%}
          Bundled quantity art: the pack size shown as that many bottles
          (one consistent render composited 1x/2x/3x).
        {%- endcomment -%}
        {%- liquid
          case qty
            when 1
              assign art_width = 223
              assign art_height = 300
            when 2
              assign art_width = 377
              assign art_height = 300
            when 3
              assign art_width = 377
              assign art_height = 369
          endcase
        -%}
        <span class="smooch-bundle__thumb smooch-bundle__thumb--art">
          <img
            src="{{ 'smooch-bundle-qty-' | append: qty | append: '.png' | asset_url }}"
            alt=""
            loading="lazy"
            width="{{ art_width }}"
            height="{{ art_height }}"
          >
        </span>
      {%- elsif product.featured_media -%}
        <span class="smooch-bundle__thumb">
          {{ product.featured_media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', sizes: '5.6rem', alt: '' }}
        </span>
      {%- endif -%}
    {%- endif -%}
    <span class="smooch-bundle__body">
      <span class="smooch-bundle__title">{{ block.settings.title }}</span>
      <span class="smooch-bundle__count" data-bundle-count-line {% if days == 0 %}hidden{% endif %}>{{ days }} Count</span>
      <span class="smooch-bundle__unit smooch-bundle__per-day" data-bundle-perday-line {% if per_day == 0 %}hidden{% endif %}>
        (<span class="smooch-num" data-bundle-per-day>{{ per_day | money }}</span> / Day)
      </span>
      <span class="smooch-bundle__soldout smooch-caption" data-bundle-soldout {% unless initially_unavailable %}hidden{% endunless %}>
        {{ 'products.product.sold_out' | t }}
      </span>
    </span>
  </span>
</label>
