{% comment %}
  Renders a star rating.

  Prefers real review data from the standard reviews.rating / reviews.rating_count
  product metafields (populated by review apps). Falls back to merchant-configured
  sample values, clearly labeled as sample data. Renders nothing when neither
  real data nor a sample count exists.

  Accepts:
  - product: {Object} product object
  - fallback_rating: {Number} sample rating used only without metafield data
  - fallback_count: {Number} sample review count; 0 hides the fallback entirely
  - show_sample_label: {Boolean} label fallback data as sample reviews
  - link: {Boolean} link to #smooch-reviews
  - size: {String} 'lg' for larger stars (optional)

  Usage:
  {% render 'smooch-rating', product: product, fallback_rating: 4.5, fallback_count: 120 %}
{% endcomment %}

{%- liquid
  assign rating_value = 0
  assign rating_count = 0
  assign is_sample = false

  if product.metafields.reviews.rating.value != blank
    assign rating_value = product.metafields.reviews.rating.value.rating
    assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  elsif fallback_count > 0
    assign rating_value = fallback_rating
    assign rating_count = fallback_count
    assign is_sample = true
  endif

-%}

{%- if rating_count > 0 -%}
  {%- capture rating_body -%}
    {%- liquid
      assign stars_class = ''
      if size == 'lg'
        assign stars_class = 'smooch-stars--lg'
      endif
      assign stars_label = 'Rated ' | append: rating_value | append: ' out of 5 stars'
    -%}
    {%- render 'smooch-stars-fractional', rating: rating_value, wrapper_class: stars_class, label: stars_label -%}
    <span class="smooch-rating__count">
      {{ rating_value }} · {{ rating_count }} review{% if rating_count != 1 %}s{% endif %}
      {%- if is_sample and show_sample_label %} <span class="smooch-fine-print">(sample)</span>{% endif %}
    </span>
    {%- if is_sample == false and settings.smooch_review_provider != blank -%}
      <span class="smooch-fine-print">{{ settings.smooch_review_provider }}</span>
    {%- endif -%}
  {%- endcapture -%}

  {%- if link -%}
    <a class="smooch-rating smooch-focus" href="#smooch-reviews" style="text-decoration: none; color: inherit;">
      {{ rating_body }}
    </a>
  {%- else -%}
    <div class="smooch-rating">
      {{ rating_body }}
    </div>
  {%- endif -%}
{%- endif -%}
