{% comment %}
  Renders an original Smooch inline SVG icon.

  Accepts:
  - icon: {String} icon name (required)
  - class: {String} extra classes on the wrapper (optional)

  Usage:
  {% render 'smooch-icon', icon: 'check', class: 'smooch-icon--lg' %}

  All icons are 24x24, stroke-based, currentColor, decorative (aria-hidden).
  Provide visible text or a visually-hidden label alongside when meaning matters.
{% endcomment %}
<span class="smooch-icon {{ class }}" aria-hidden="true">
  {%- case icon -%}
    {%- when 'star' -%}
      <svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.4L12 17.4l-5.8 3 1.1-6.4L2.6 9.4l6.5-.9L12 2.6z"/></svg>
    {%- when 'star-half' -%}
      <span style="position: relative; display: inline-flex; width: 100%; height: 100%;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" focusable="false"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.4L12 17.4l-5.8 3 1.1-6.4L2.6 9.4l6.5-.9L12 2.6z"/></svg>
        <span style="position: absolute; inset: 0; width: 50%; overflow: hidden;">
          <svg viewBox="0 0 24 24" fill="currentColor" focusable="false" style="width: 200%; height: 100%; max-width: none;"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.4L12 17.4l-5.8 3 1.1-6.4L2.6 9.4l6.5-.9L12 2.6z"/></svg>
        </span>
      </span>
    {%- when 'star-empty' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" focusable="false"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.4L12 17.4l-5.8 3 1.1-6.4L2.6 9.4l6.5-.9L12 2.6z"/></svg>
    {%- when 'check' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4.5 12.5l5 5 10-11"/></svg>
    {%- when 'heart' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 20.4S3.5 15.4 3.5 9.3c0-2.9 2.2-5 4.9-5 1.5 0 2.8.7 3.6 1.9.8-1.2 2.1-1.9 3.6-1.9 2.7 0 4.9 2.1 4.9 5 0 6.1-8.5 11.1-8.5 11.1z"/></svg>
    {%- when 'sparkle' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 3v4.5M12 16.5V21M3 12h4.5M16.5 12H21M6.2 6.2l2.6 2.6M15.2 15.2l2.6 2.6M6.2 17.8l2.6-2.6M15.2 8.8l2.6-2.6"/></svg>
    {%- when 'moon' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
    {%- when 'leaf' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M20 4C10 4 4.5 9.5 4.5 19.5 14.5 19.5 20 14 20 4z"/><path d="M4.5 19.5C8 14 12 10.5 17 7.5"/></svg>
    {%- when 'drop' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 3s6.5 7 6.5 11.5a6.5 6.5 0 1 1-13 0C5.5 10 12 3 12 3z"/></svg>
    {%- when 'glow' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" focusable="false"><circle cx="12" cy="12" r="3.2"/><path d="M12 5.2a6.8 6.8 0 0 1 6.8 6.8"/><path d="M12 2.2a9.8 9.8 0 0 1 9.8 9.8" opacity="0.5"/></svg>
    {%- when 'ember' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 3.2c-2.7 3.3-4.3 5.7-4.3 8.3a4.3 4.3 0 0 0 8.6 0c0-1-.3-1.9-.8-2.8-.4.9-1 1.5-1.7 1.6.5-2-.2-4.2-1.8-7.1z"/></svg>
    {%- when 'ripple' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false"><circle cx="12" cy="12" r="1.8" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="5.2" opacity="0.55"/><circle cx="12" cy="12" r="8.8" opacity="0.3"/></svg>
    {%- when 'entwine' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" focusable="false"><path d="M10.2 6.2a6.3 6.3 0 1 0 0 11.6"/><path d="M13.8 6.2a6.3 6.3 0 1 1 0 11.6"/></svg>
    {%- when 'truck' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M2.5 6h11v10h-11zM13.5 9.5h4l3 3.5v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="16.5" cy="17.5" r="1.8"/></svg>
    {%- when 'verified' -%}
      <svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M23 12l-2.44-2.79.34-3.69-3.61-.82-1.89-3.2L12 2.96 8.6 1.5 6.71 4.69l-3.61.82.34 3.68L1 12l2.44 2.79-.34 3.69 3.61.82 1.89 3.2L12 21.04l3.4 1.46 1.89-3.19 3.61-.82-.34-3.69L23 12zm-12.91 4.72l-3.8-3.81 1.48-1.48 2.32 2.33 5.85-5.87 1.48 1.48-7.33 7.35z"/></svg>
    {%- when 'shield' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 3l7.5 2.7v5.6c0 4.6-3 8-7.5 9.7-4.5-1.7-7.5-5.1-7.5-9.7V5.7L12 3z"/><path d="M8.8 12l2.2 2.2 4.2-4.4"/></svg>
    {%- when 'lock' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="4.5" y="10.5" width="15" height="9.5" rx="1.8"/><path d="M8 10.5V7.8a4 4 0 0 1 8 0v2.7"/></svg>
    {%- when 'gift' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="3.5" y="8" width="17" height="4" rx="0.8"/><path d="M5 12v8.5h14V12M12 8v12.5M12 8S9.5 3.5 7 4.5 8.5 8 12 8zM12 8s2.5-4.5 5-3.5S15.5 8 12 8z"/></svg>
    {%- when 'tag' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M11.5 3.5H5a1.5 1.5 0 0 0-1.5 1.5v6.5a1.5 1.5 0 0 0 .44 1.06l8 8a1.5 1.5 0 0 0 2.12 0l6.5-6.5a1.5 1.5 0 0 0 0-2.12l-8-8a1.5 1.5 0 0 0-1.06-.44z"/><circle cx="8" cy="8" r="1.4"/></svg>
    {%- when 'briefcase' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="3" y="7.5" width="18" height="12" rx="1.8"/><path d="M8 7.5V5.8a1.8 1.8 0 0 1 1.8-1.8h4.4A1.8 1.8 0 0 1 16 5.8v1.7"/><path d="M3 13h18"/></svg>
    {%- when 'refresh' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4 12a8 8 0 0 1 13.7-5.7L20 8.5M20 12a8 8 0 0 1-13.7 5.7L4 15.5"/><path d="M20 4v4.5h-4.5M4 20v-4.5h4.5"/></svg>
    {%- when 'clock' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5.5l3.5 2"/></svg>
    {%- when 'box' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5v-9z"/><path d="M3.5 7.5L12 12l8.5-4.5M12 12v9"/></svg>
    {%- when 'mail' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="3" y="5.5" width="18" height="13" rx="1.8"/><path d="M3.5 7l8.5 6 8.5-6"/></svg>
    {%- when 'plus' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
    {%- when 'minus' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" focusable="false"><path d="M5 12h14"/></svg>
    {%- when 'close' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
    {%- when 'arrow-right' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
    {%- when 'arrow-left' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M20 12H4M10 6l-6 6 6 6"/></svg>
    {%- when 'caret' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M6 9.5l6 6 6-6"/></svg>
    {%- when 'quote' -%}
      <svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M10.2 6.2c-3 1.4-4.7 3.7-4.7 6.5 0 .3 0 .5.1.8a3.5 3.5 0 1 1-1.5 4.5C3.4 16.9 3 15.5 3 14c0-4 2.3-7.3 6.2-9.3l1 1.5zm10 0c-3 1.4-4.7 3.7-4.7 6.5 0 .3 0 .5.1.8a3.5 3.5 0 1 1-1.5 4.5c-.7-1.1-1.1-2.5-1.1-4 0-4 2.3-7.3 6.2-9.3l1 1.5z"/></svg>
    {%- when 'info' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" focusable="false"><circle cx="12" cy="12" r="8.5"/><path d="M12 11v5.5"/><circle cx="12" cy="7.8" r="0.4" fill="currentColor"/></svg>
    {%- when 'user' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="12" cy="8.2" r="3.7"/><path d="M4.5 20c1.3-3.6 4.3-5.5 7.5-5.5s6.2 1.9 7.5 5.5"/></svg>
    {%- when 'bag' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M6.5 8.5h11l0.9 11.5a1.6 1.6 0 0 1-1.6 1.7H7.2a1.6 1.6 0 0 1-1.6-1.7z"/><path d="M9 8V6.8a3 3 0 0 1 6 0V8"/></svg>
    {%- when 'menu' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    {%- when 'search' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" focusable="false"><circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5 5"/></svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" focusable="false"><circle cx="12" cy="12" r="8.5"/></svg>
  {%- endcase -%}
</span>
